# --- Password API ---
# Protegge l'accesso alle API del proxy. Se impostata, deve essere passata
# come parametro query (?api_password=...) o header (x-api-password).
API_PASSWORD=

# --- Porta del Server ---
# Specifica la porta su cui il server deve ascoltare (default: 7860)
PORT=8760
CONFIG_DIR=/data
