# ============================== #
# Stremio Add-on Configuration    #
# ============================== #
ADDON_ID=
ADDON_NAME=

# ============================== #
# FastAPI Server Configuration   #
# ============================== #
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=2020
# DO NOT change this if you don't know what you are doing. Setting this to -1 will spawn a worker for each CPU core, which can consume several GBs of RAM and cause high CPU usage.
FASTAPI_WORKERS=1
# Will use uvicorn if False or if on Windows
USE_GUNICORN=True
# Max workers for ProcessPoolExecutor (handles CPU-intensive tasks like RTN parsing). Recommended: 1. Do not exceed 4 unless you have a high-end machine.
EXECUTOR_MAX_WORKERS=4

# ============================== #
# Playback Settings              #
# ============================== #
# Optional: force playback URLs to use this public base (e.g. https://comet.example.com). Leave empty to use the request host.
PUBLIC_BASE_URL=""

# ============================== #
# Dashboard Settings             #
# ============================== #
# Direct password; empty generates one in the shared database on first startup
ADMIN_DASHBOARD_PASSWORD=
# Session lifetime for the admin dashboard login cookie (seconds)
ADMIN_DASHBOARD_SESSION_TTL=86400

# ============================== #
# Configuration Page Security    #
# ============================== #
# Optional: protect /configure and /{config}/configure with a password (disabled if empty)
CONFIGURE_PAGE_PASSWORD=
# Session lifetime for the configuration page login cookie (seconds)
CONFIGURE_PAGE_SESSION_TTL=86400
# Optional: token used in the Stremio API prefix /s/<token>. If empty and CONFIGURE_PAGE_PASSWORD is set, Comet auto-generates one.
PUBLIC_API_TOKEN=
# File used to persist the auto-generated PUBLIC_API_TOKEN outside the database
PUBLIC_API_TOKEN_FILE=data/public_api_token.txt

# ============================== #
# Database Configuration         #
# ============================== #
# ⚠️  WARNING: SQLite has POOR CONCURRENCY support and should ONLY be used for development/testing!
# SQLite cannot handle multiple concurrent writers well, leading to:
#   - "database is locked" errors with multiple workers
#   - Performance issues with background scraper
#   - Data corruption risks under heavy load
# For production deployments, use PostgreSQL!
# Options: sqlite, postgresql - Use postgresql for production, sqlite for development only
DATABASE_TYPE=postgresql
# Optional explicit PostgreSQL URL; compose derives it from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB when empty
DATABASE_URL=

# TORRENT_CACHE_TTL: Controls when torrents are PERMANENTLY REMOVED from the database.
#    Set to -1 to disable automatic removal (torrents stay forever).
# Never expires (custom; sample default: 2592000 / 30 days)
TORRENT_CACHE_TTL=-1

# LIVE_TORRENT_CACHE_TTL: Controls when a NEW LIVE SEARCH is triggered.
#    If the cache is older than this value, Comet performs a new search to find new torrents.
#    Important: Old cached torrents are ALWAYS included in results, this only controls refresh frequency.
#    Set to -1 to never trigger new searches (always use existing cache only).
#86400 # 1 day (custom; sample default: 604800 / 7 days)
LIVE_TORRENT_CACHE_TTL=86400

# LIVE_TORRENT_CACHE_RECENT_TTL: Refresh interval for titles whose release is
#    less than LIVE_TORRENT_CACHE_TTL old. Searches made before release expire
#    at the release boundary. Set to -1 to disable release-aware refreshes.
# 1 hour
LIVE_TORRENT_CACHE_RECENT_TTL=3600

# ======================================================= #
# Background Scraper                                      #
# Zilean and no-ratelimit indexers/scrapers recommended!  #
# PostgreSQL recommended for high worker count!           #
# ======================================================= #
# Auto-start background scraper when Comet starts (manual start from admin UI still possible if False)
BACKGROUND_SCRAPER_ENABLED=true
# Number of concurrent workers for scraping (adjust depending on whether you are often ratelimited by scrapers)
BACKGROUND_SCRAPER_CONCURRENT_WORKERS=8
# Interval between scraping cycles in seconds
BACKGROUND_SCRAPER_INTERVAL=600
# Maximum number of movies to scrape per run
BACKGROUND_SCRAPER_MAX_MOVIES_PER_RUN=700
# Maximum number of series to scrape per run
BACKGROUND_SCRAPER_MAX_SERIES_PER_RUN=500
# Successful scrape cooldown before re-scraping same media (seconds)
BACKGROUND_SCRAPER_SUCCESS_TTL=259200
# Initial retry delay for failed scrapes (seconds)
BACKGROUND_SCRAPER_FAILURE_BASE_BACKOFF=1800
# Maximum retry delay for failed scrapes (seconds)
BACKGROUND_SCRAPER_FAILURE_MAX_BACKOFF=259200
# Max consecutive failed attempts before marking item as dead
BACKGROUND_SCRAPER_MAX_RETRIES=8
# Soft runtime budget for one run/cycle (seconds)
BACKGROUND_SCRAPER_RUN_TIME_BUDGET=3600
# Discover this multiplier * planned items each cycle
BACKGROUND_SCRAPER_DISCOVERY_MULTIPLIER=3
# Cap episodes scraped per series in one cycle
BACKGROUND_SCRAPER_MAX_EPISODES_PER_SERIES_PER_RUN=25
# Refresh known series episodes from Cinemeta when older than this TTL (seconds)
BACKGROUND_SCRAPER_EPISODE_REFRESH_TTL=21600
# Prioritize items recently requested by users
BACKGROUND_SCRAPER_ENABLE_DEMAND_PRIORITY=True
# Recency window for demand boost from first_searches (seconds)
BACKGROUND_SCRAPER_DEMAND_LOOKBACK=259200
# Cooldown applied when item is deferred due run budget/cancel (seconds)
BACKGROUND_SCRAPER_DEFER_COOLDOWN=180
# Resume discovery only when queue drops to or below this level
BACKGROUND_SCRAPER_QUEUE_LOW_WATERMARK=20000
# Pause discovery when queue reaches this level (hysteresis with LOW)
BACKGROUND_SCRAPER_QUEUE_HIGH_WATERMARK=50000
# Safety cap: force discovery pause when queue reaches this level
BACKGROUND_SCRAPER_QUEUE_HARD_CAP=80000
# Degrade health when 24h fail rate exceeds this ratio
BACKGROUND_SCRAPER_ALERT_FAIL_RATE=0.25
# Degrade health when eligible work has waited longer than this (seconds)
BACKGROUND_SCRAPER_ALERT_QUEUE_AGE=604800
# Retention for run history table
BACKGROUND_SCRAPER_RUN_RETENTION_DAYS=14


# ============================== #
# Anime Mapping Configuration    #
# ============================== #
# Anime Mapping is used to match IMDb/Kitsu IDs to Anime specific IDs (AniList, MAL, Kitsu, etc.) to retrieve title aliases.
# This greatly improves title matching performances for anime content by using accurate alternative titles.
ANIME_MAPPING_ENABLED=True
# Seconds between background anime mapping refreshes when using database cache (<=0 disables)
ANIME_MAPPING_REFRESH_INTERVAL=432000
# Built-in scrapers only: always uses their proxy, on_failure tries direct first, never disables it
PROXY_ETHOS=always
# Strict proxy for every HTTP destination supplied by an add-on user: Newznab/NZBHydra/Prowlarr Usenet,
# custom Stremio add-ons, AltMount, NzbDAV, StremThru Newz, and their NZB downloads/redirects.
# Supports http(s), socks4(a), and socks5(h). It never falls back to a direct connection, regardless of PROXY_ETHOS.
# This setting covers HTTP(S), not personal NNTP servers.
# Leave empty to connect to user-provided destinations directly. Example: socks5h://<username>:<password>@proxy.example.invalid:1080
USER_PROVIDED_PROXY_URL=""
TORRENTIO_PROXY_URL=

# ============================== #
# Jackett & Prowlarr Settings    #
# ============================== #

# Jackett Configuration
# Context mode: live, background, both, false
# SCRAPE_JACKETT=live
SCRAPE_JACKETT=both
JACKETT_URL=
JACKETT_API_KEY=

# ============================== #
# Scraping Configuration         #
# ============================== #
# Multi-Instance Scraping Support:
# - Single URL: Use a simple string for one instance (default behavior)
# - Multiple URLs: Use JSON array format for multiple instances
# - Optional per-instance mode: append :both, :live, or :background to each URL
# - Example single: COMET_URL=https://comet.example.invalid
# - Example multi: COMET_URL='["https://comet1.example.com", "https://comet2.example.com"]'
# - Example mixed: BITMAGNET_URL='["http://example.invalid", "https://public-bitmagnet.example.com:live"]'
#
# Scraper Context Modes:
# Each SCRAPE_* setting can control when scrapers are used:
# - true/both: Used for live scraping AND background scraping (default)
# - live: Only used for live scraping (when users request content)
# - background: Only used for background scraping (automatic content pre-caching)
# - false: Completely disabled
#
# Examples:
# SCRAPE_COMET=both

SCRAPE_COMET=live
# Multi-instance example:
# COMET_URL='["https://comet-one.example.invalid", "https://comet2.example.com"]'
COMET_URL=
# SCRAPE_NYAA=false

SCRAPE_NYAA=live
# Only scrape Nyaa if the content is anime
NYAA_ANIME_ONLY=True
# Maximum number of concurrent requests to Nyaa (consider reducing if you are often ratelimited by Nyaa)
NYAA_MAX_CONCURRENT_PAGES=5

# Torrent discovery
SCRAPE_ANIMETOSHO=False
# Usenet/NZB discovery
SCRAPE_ANIMETOSHO_USENET=False
# Only scrape AnimeTosho if the content is anime
ANIMETOSHO_ANIME_ONLY=True
# Maximum number of concurrent requests to AnimeTosho (consider reducing if you are often ratelimited by AnimeTosho)
ANIMETOSHO_MAX_CONCURRENT_PAGES=10

# requires ANIME_MAPPING_ENABLED to be True
SCRAPE_SEADEX=live
# Only scrape SeaDex if the content is anime
SEADEX_ANIME_ONLY=True

SCRAPE_NEKOBT=live
# Only scrape NekoBT if the content is anime
NEKOBT_ANIME_ONLY=True
# SCRAPE_ZILEAN=background

SCRAPE_ZILEAN=both
# Multi-instance example:
# ZILEAN_URL='["https://zilean1.example.com", "https://zilean2.example.com"]'
ZILEAN_URL=

SCRAPE_STREMTHRU=both
# Multi-instance example:
# STREMTHRU_SCRAPE_URL='["https://stremthru1.example.com", "https://service.example.invalid"]'
STREMTHRU_SCRAPE_URL=

# Debrid Media Manager (DMM) Scraper & Ingester
# SCRAPE_DMM: Choose when to search the LOCAL DMM cache (migrated from hashlists)
SCRAPE_DMM=both

# DMM Ingester: Automatically downloads and indexes DMM hashlists into your local database.
# This is REQUIRED for SCRAPE_DMM to return results.
DMM_INGEST_ENABLED=true
# Seconds between ingestion cycles (default: 1 day)
DMM_INGEST_INTERVAL=86400
# Number of concurrent workers for DMM ingestion. Increase this if you have a powerful CPU. Make sure EXECUTOR_MAX_WORKERS is set to at least this value.
DMM_INGEST_CONCURRENT_WORKERS=4
# Number of files to process per batch. Increase this for better throughput if your CPU can handle it.
DMM_INGEST_BATCH_SIZE=1000

SCRAPE_BITMAGNET=false

# Multi-instance example:
# BITMAGNET_URL='["https://bitmagnet1.example.com", "https://bitmagnet2.example.com"]'
# BITMAGNET_URL='["http://example.invalid", "https://example.invalid"]'
BITMAGNET_URL=
BITMAGNET_MAX_CONCURRENT_PAGES=5
# SCRAPE_TORRENTIO=live

SCRAPE_TORRENTIO=live
# Multi-instance example:
# TORRENTIO_URL='["https://torrentio-one.example.invalid", "https://torrentio-two.example.invalid"]'
TORRENTIO_URL=

SCRAPE_MEDIAFUSION=False
# Multi-instance MediaFusion examples:
# MEDIAFUSION_URL='["https://mediafusion1.example.com", "https://mediafusion2.example.com"]'
MEDIAFUSION_URL=
# API password for MediaFusion instances that require authentication
# MEDIAFUSION_API_PASSWORD=  # Supplied by Infisical; keep the public value empty.
MEDIAFUSION_API_PASSWORD=
MEDIAFUSION_LIVE_SEARCH=true

SCRAPE_AIOSTREAMS=False
# Multi-instance AIOStreams examples:
# AIOSTREAMS_URL='["https://aio1.example.com", "https://aio2.example.com"]'
AIOSTREAMS_URL=
# AIOSTREAMS_USER_UUID_AND_PASSWORD=  # Supplied by Infisical; keep the public value empty.
AIOSTREAMS_USER_UUID_AND_PASSWORD=

SCRAPE_JACKETTIO=False
# Full manifest URL without /manifest.json at the end
# Multi-instance example:
# JACKETTIO_URL='["https://jackettio1.example.com", "https://jackettio2.example.com"]'
JACKETTIO_URL=

SCRAPE_DEBRIDIO=False
DEBRIDIO_API_KEY=
# alldebrid, debrider, debridlink, easydebrid, premiumize, realdebrid, torbox
DEBRIDIO_PROVIDER=torbox
DEBRIDIO_PROVIDER_KEY=



SCRAPE_TORRENTSDB=live

SCRAPE_PEERFLIX=live

# ============================== #
# Debrid Stream Proxy Settings   #
# ============================== #
PROXY_DEBRID_STREAM=True
# Requested during Comet configuration; if incorrect, streams will not be proxied (Randomly generated if not set)
PROXY_DEBRID_STREAM_PASSWORD=
# -1 to disable connection limits
PROXY_DEBRID_STREAM_MAX_CONNECTIONS=-1
PROXY_DEBRID_STREAM_DEBRID_DEFAULT_SERVICE=torbox
PROXY_DEBRID_STREAM_DEBRID_DEFAULT_APIKEY=
# Seconds to wait before cleaning up an inactive connection. Set to 0 to disable.
PROXY_DEBRID_STREAM_INACTIVITY_THRESHOLD=300

# ============================== #
# StremThru Integration          #
# ============================== #
# needed to use debrid services
STREMTHRU_URL=

# === RELAY MODE SETTINGS (for clusters) ===
# URL of standalone CometNet service (e.g. http://service.example.invalid). When set, COMETNET_ENABLED is ignored.
COMETNET_RELAY_URL=
# API key for standalone service authentication (Randomly generated if not set)
COMETNET_API_KEY=
