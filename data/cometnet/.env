# API key for standalone service authentication (Randomly generated if not set)
COMETNET_API_KEY=
COMETNET_BOOTSTRAP_NODES=
# Public URL to advertise to peers (e.g. wss://comet.example.com/cometnet/ws). Required if behind reverse proxy/domain.
COMETNET_ADVERTISE_URL=
# Optional friendly name for this node (exchanged with other peers)
COMETNET_NODE_ALIAS=
COMETNET_CONTRIBUTION_MODE=leech
# WebSocket port for incoming P2P connections (ensure it's accessible if behind NAT)
COMETNET_LISTEN_PORT=8765
# HTTP API port (only used by standalone service)
COMETNET_HTTP_PORT=8766
# Options: sqlite, postgresql - Use postgresql for production, sqlite for development only
DATABASE_TYPE=postgresql
# Database connection URL (format depends on DATABASE_TYPE, e.g. postgresql://example.invalid for PostgreSQL)
DATABASE_URL=
TORRENT_CACHE_TTL=-1
