TZ=Europe/Rome
WUD_AUTH_ADMIN_USER=admin

# Controllo giornaliero alle 04:30
WUD_WATCHER_LOCAL_CRON="0 5 * * *"
WUD_WATCHER_LOCAL_JITTER=0
WUD_WATCHER_LOCAL_WATCHBYDEFAULT=true
WUD_WATCHER_LOCAL_WATCHDIGESTDEFAULT=true

# Evita aggiornamenti fuori orario
WUD_WATCHER_LOCAL_WATCHATSTART=false
WUD_WATCHER_LOCAL_WATCHEVENTS=false

# Aggiornamento automatico, incluso WUD
WUD_TRIGGER_DOCKER_LOCAL_AUTO=true
WUD_TRIGGER_DOCKER_LOCAL_PRUNE=true
WUD_TRIGGER_DOCKER_LOCAL_SELFUPDATE=true
WUD_WATCHER_LOCAL_EXCLUDE=^gluetun$
