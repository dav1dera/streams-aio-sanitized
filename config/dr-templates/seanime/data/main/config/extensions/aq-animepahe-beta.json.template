{
  "id": "aq-animepahe-beta",
  "name": "AnimePahe - BETA",
  "version": "0.2.43",
  "manifestURI": "https://raw.githubusercontent.com/aquaryuo/seanime/beta/extensions/animepahe/manifest.json",
  "language": "typescript",
  "type": "onlinestream-provider",
  "description": "Only animepahe compatibility layer you'll ever need",
  "author": "aquaryuo",
  "icon": "https://raw.githubusercontent.com/aquaryuo/seanime/beta/extensions/animepahe/icon.png",
  "website": "https://animepahe.pw",
  "readme": "",
  "lang": "en",
  "userConfig": {
    "version": 1,
    "requiresConfig": false,
    "fields": [
      {
        "type": "select",
        "name": "baseUrl",
        "label": "Site domain — the old domains below redirect to animepahe.pw",
        "options": [
          {
            "value": "https://animepahe.pw",
            "label": "animepahe.pw (current)"
          },
          {
            "value": "https://animepahe.com",
            "label": "animepahe.com (redirects to .pw)"
          },
          {
            "value": "https://animepahe.org",
            "label": "animepahe.org (redirects to .pw)"
          }
        ],
        "default": "https://animepahe.pw"
      },
      {
        "type": "text",
        "name": "solverUrl",
        "label": "[!] Solver endpoint — run it via Aqua's Utils",
        "default": "@@INFISICAL:/shared/SEANIME_SOLVER_URL@@"
      },
      {
        "type": "text",
        "name": "solverSession",
        "label": "Solver session — must match Aqua's Utils (default: seanime)",
