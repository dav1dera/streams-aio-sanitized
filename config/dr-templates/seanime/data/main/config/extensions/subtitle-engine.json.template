"inline\"] .se-overlay { flex: 1; min-height: 0; }\n        .se-overlay { display: flex; align-items: center; justify-content: center; }\n        .se-root[data-view=\"modal\"] .se-overlay {\n            position: fixed;\n            inset: 0;\n            z-index: 50;\n            padding: 24px;\n            background: rgba(0, 0, 0, 0.8);\n            backdrop-filter: blur(3px);\n            -webkit-backdrop-filter: blur(3px);\n            animation: seFadeIn 0.15s ease;\n        }\n        @keyframes seFadeIn { from { opacity: 0; } to { opacity: 1; } }\n\n        .se-card {\n            display: flex;\n            flex-direction: column;\n            overflow: hidden;\n            width: 100%;\n            background: var(--se-paper);\n            border: 1px solid var(--se-border);\n            border-radius: 12px;\n            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);\n        }\n        .se-root[data-view=\"inline\"] .se-card { height: 100%; }\n        .se-root[data-view=\"inline\"][data-transparent=\"true\"] .se-card {\n            background: transparent;\n            border-color: transparent;\n            box-shadow: none;\n        }\n        .se-root[data-view=\"modal\"] .se-card {\n            max-width: 900px;\n            max-height: min(86vh, 840px);\n            border-color: rgba(255, 255, 255, 0.05);\n            border-radius: 16px;\n            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.65);\n            animation: seZoomIn 0.18s cubic-bezier(0.22, 1, 0.36, 1);\n        }\n        @keyframes seZoomIn {\n            from { opacity: 0; transform: scale(0.96); }\n            to { opacity: 1; transform: scale(1); }\n        }\n\n        .se-card-header {\n            flex: none;\n            display: flex;\n            align-items: flex-start;\n            justify-content: space-between;\n            gap: 12px;\n            padding: 18px 20px;\n            border-bottom: 1px solid var(--se-border);\n        }\n        .se-root[data-transparent=\"true\"] .se-card-header { padding-left: 0; padding-right: 0; }\n        .se-card-title {\n            display: flex;\n            align-items: center;\n            gap: 8px;\n            font-size: 18px;\n            font-weight: 600;\n            letter-spacing: -0.01em;\n            color: var(--se-fg-strong);\n            line-height: 1.2;\n        }\n        .se-card-desc { display: flex; align-items: center; gap: 8px; margin-top: 8px; }\n        .se-actions { display: flex; align-items: center; gap: 6px; flex: none; }\n\n        .se-card-body {\n            flex: 1;\n            min-height: 0;\n            overflow-y: auto;\n            padding: 16px 20px 20px;\n        }\n        .se-root[data-transparent=\"true\"] .se-card-body { padding-left: 0; padding-right: 0; }\n\n        .controls-section { flex: none; }\n\n        /* ==========================================================================\n           Status badges & provider pills (Seanime Badge anatomy)\n           ========================================================================== */\n        .badge-count {\n            display: inline-flex;\n            align-items: center;\n            gap: 6px;\n            height: 22px;\n            padding: 0 8px;\n            border-radius: 100px;\n            font-size: 12px;\n            font-weight: 600;\n            letter-spacing: 0.02em;\n            color: rgb(202 202 202);\n            background: rgba(90, 90, 90, 0.1);\n            border: 1px solid rgba(90, 90, 90, 0.4);\n            transition: background 0.15s, border-color 0.15s, color 0.15s;\n        }\n        .badge-count.searching {\n            color: rgb(147 197 253);\n            background: rgba(59, 130, 246, 0.1);\n            border-color: rgba(59, 130, 246, 0.4);\n        }\n        .badge-dots { display: inline-flex; gap: 3px; align-items: center; }\n        .badge-dots span {\n            width: 4px;\n            height: 4px;\n            border-radius: 50%;\n            background: rgb(147 197 253);\n            animation: dot-bounce 1.4s infinite ease-in-out both;\n        }\n        .badge-dots span:nth-child(1) { animation-delay: -0.32s; }\n        .badge-dots span:nth-child(2) { animation-delay: -0.16s; }\n        .badge-dots span:nth-child(3) { animation-delay: 0s; }\n        @keyframes dot-bounce {\n            0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }\n            40% { transform: scale(1); opacity: 1; }\n        }\n\n        .providers { display: flex; gap: 6px; margin-bottom: 14px; flex-wrap: wrap; }\n        .provider-pill {\n            display: inline-flex;\n            align-items: center;\n            gap: 6px;\n            height: 22px;\n            padding: 0 8px;\n            border-radius: 100px;\n            font-size: 12px;\n            font-weight: 600;\n            letter-spacing: 0.02em;\n            color: rgb(202 202 202);\n            background: rgba(90, 90, 90, 0.1);\n            border: 1px solid rgba(90, 90, 90, 0.4);\n        }\n        .provider-pill.active {\n            color: rgb(225 225 225);\n            background: rgba(225, 225, 225, 0.1);\n        }\n        .provider-pill.active::before {\n            content: \"\";\n            width: 6px;\n            height: 6px;\n            border-radius: 50%;\n            background: rgb(46 138 89);\n            animation: pulse-dot 1.4s infinite;\n        }\n        @keyframes pulse-dot {\n            0%, 100% { transform: scale(1); opacity: 1; }\n            50% { transform: scale(0.6); opacity: 0.5; }\n        }\n\n        /* ==========================================================================\n           Selects (Radix-style trigger + floating panel)\n           ========================================================================== */\n        .filters {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));\n            gap: 12px;\n            margin-bottom: 14px;\n        }\n        