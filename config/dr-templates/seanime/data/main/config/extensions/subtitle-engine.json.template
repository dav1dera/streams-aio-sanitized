{
  "id": "subtitle-engine",
  "name": "Subtitle Engine",
  "version": "1.9.0",
  "manifestURI": "https://raw.githubusercontent.com/Thekingcrusher/seanime-plugins/refs/heads/main/subtitle-engine/manifest.json",
  "language": "typescript",
  "type": "plugin",
  "description": "Add subtitles of your preferred language and format from multiple different sources to your current videocore session.",
  "author": "Thekingcrusher",
  "icon": "https://raw.githubusercontent.com/Thekingcrusher/seanime-plugins/refs/heads/main/subtitle-engine/icon.png",
  "website": "",
  "readme": "",
  "lang": "multi",
  "payload": "/// <reference path=\"../../core.d.ts\" />\n/// <reference path=\"../../plugin.d.ts\" />\n/// <reference path=\"../../app.d.ts\" />\n/// <reference path=\"../../system.d.ts\" />\n\n//@ts-ignore\nfunction init() {\n    $ui.register((ctx) => {\n        // ============================================================\n        // SETTINGS (stored in $storage instead of user preferences)\n        // ============================================================\n        const SK_SETTINGS = \"SUBTITLE_ENGINE_SETTINGS\";\n\n        function getSettings(): any {\n            return ($storage.get(SK_SETTINGS) as any) ?? {\n                jimakuKey: \"\",\n                language: \"all\",\n                source: \"animetoshoSource\",\n                format: \"all\",\n                hi: \"false\",\n                signSong: \"false\",\n                honorifics: \"false\",\n                fansub: \"all\",\n                autoSelect: \"none\",\n                webviewPosition: \"fixed\",\n                fixedCorner: \"bottom-right\",\n                transparentBg: \"true\",\n                font: \"\"\n            };\n        }\n\n        function saveSettings(s: any) { $storage.set(SK_SETTINGS, s); }\n\n        // ============================================================\n        // WEBVIEW SETUP - Two webviews for different positions\n        // ============================================================\n        const _initSettings = getSettings();\n\n        // The \"fixed\" position is a centered popup, so the webview itself covers\n        // the whole window and renders the modal + blacked-out backdrop.\n        function buildFixedWebviewOptions(): any {\n            return {\n                slot: \"fixed\",\n                autoHeight: false,\n                hidden: true,\n                fullWidth: true,\n                width: \"100vw\",\n                height: \"100vh\",\n                zIndex: 9999,\n                style: \"inset: 0; width: 100vw; height: 100vh;\",\n                window: {\n                    draggable: false,\n                    frameless: true,\n                    defaultX: 0,\n                    defaultY: 0\n                }\n            };\n        }\n\n        function buildBlockWebviewOptions(): any {\n            return {\n                slot: \"before-anime-entry-episode-list\",\n                autoHeight: false,\n                hidden: true,\n                fullWidth: true,\n                height: \"800px\"\n            };\n        }\n\n        const fixedWebview = ctx.newWebview(buildFixedWebviewOptions());\n        const blockWebview = ctx.newWebview(buildBlockWebviewOptions());\n\n        // Track which webview is currently active\n        let activeWebview: \"fixed\" | \"block\" = _initSettings.webviewPosition === \"fixed\" ? \"fixed\" : \"block\";\n\n        function showCorrectWebview() {\n            const settings = getSettings();\n            const shouldShowFixed = settings.webviewPosition === \"fixed\";\n            if (shouldShowFixed) {\n                blockWebview.hide();\n                fixedWebview.show();\n                activeWebview = \"fixed\";\n            } else {\n                fixedWebview.hide();\n                blockWebview.show();\n                activeWebview = \"block\";\n            }\n        }\n\n        // ============================================================\n        // PROVIDERS\n        // ============================================================\n        const animetoshoAPI = \"https://feed.animetosho.net\";\n        const jimakuAPI = \"https://jimaku.cc/api\";\n        const tsukihimeAPI = \"https://api.tsukihime.org/v1\";\n        const tsukihimeStorage = \"https://storage.tsukihime.org\";\n        const ANIMELIST_URL = \"https://raw.githubusercontent.com/ThaUnknown/anime-lists-ts/refs/heads/main/data/anime-list.json\";\n        const TMDB_API_BASE = \"https://api.themoviedb.org/3\";\n\n        // ============================================================\n        // FILTER STATE (plain vars — webview owns the UI state)\n        // ============================================================\n        const _settings = getSettings();\n        let filterLang = _settings.language || \"all\";\n        let filterSource = _settings.source || \"animetoshoSource\";\n        let filterFormat = _settings.format || \"all\";\n        let filterHi = _settings.hi === \"true\";\n        let filterSign = _settings.signSong === \"true\";\n        let filterHonor = _settings.honorifics === \"true\";\n        let filterFanSub = _settings.fansub || \"all\";\n        let filterImdb = \"\";\n        let filterSeason = \"\";\n        let filterEpisode = \"\";\n\n        // ============================================================\n        // APP STATE\n        // ============================================================\n        const subtitleResults = ctx.state<any[]>([]);\n        const filteredSubtitleResults = ctx.state<any[]>([]);\n        const isSearching = ctx.state<boolean>(false);\n        const searchProviders = ctx.state<Record<string, boolean>>({});\n        const lastSearchedKey = ctx.state<string>(\"\");\n        const selectedSubUrls = ctx.state<string[]>([]);\n        const activeSession = ctx.state<boolean>(false);\n        const autoSelected = ctx.state<string>(\"\");\n\n        const pluginConfig = ctx.state({\n            hasJimakuKey: !!(_settings.jimakuKey),\n            autoSelect: _settings.autoSelect || \"none\"\n        });\n\n        const settingsState = ctx.state({\n            jimakuKey: _settings.jimakuKey || \"\",\n            language: _settings.language || \"all\",\n            source: _settings.source || \"animetoshoSource\",\n            format: _settings.format || \"all\",\n            hi: _settings.hi === \"true\",\n            signSong: _settings.signSong === \"true\",\n            honorifics: _settings.honorifics === \"true\",\n            fansub: _settings.fansub || \"all\",\n            autoSelect: _settings.autoSelect || \"none\",\n            webviewPosition: _settings.webviewPosition || \"before-anime-entry-episode-list\",\n            fixedCorner: _settings.fixedCorner || \"top-right\",\n            transparentBg: _settings.transparentBg === true || _settings.transparentBg === \"true\",\n            font: _settings.font || \"\"\n        });\n\n        const filterConfigState = ctx.state({\n            lang: filterLang,\n            source: filterSource,\n            format: filterFormat,\n            hi: filterHi,\n            sign: filterSign,\n            honor: filterHonor,\n            fansub: filterFanSub,\n            imdb: filterImdb,\n            season: filterSeason,\n            episode: filterEpisode\n        });\n\n        // Sync to both webviews\n        fixedWebview.channel.sync(\"subtitles\", filteredSubtitleResults);\n        fixedWebview.channel.sync(\"isSearching\", isSearching);\n        fixedWebview.channel.sync(\"searchProviders\", searchProviders);\n        fixedWebview.channel.sync(\"selectedUrls\", selectedSubUrls);\n        fixedWebview.channel.sync(\"activeSession\", activeSession);\n        fixedWebview.channel.sync(\"filterConfig\", filterConfigState);\n        fixedWebview.channel.sync(\"pluginConfig\", pluginConfig);\n        fixedWebview.channel.sync(\"settings\", settingsState);\n\n        blockWebview.channel.sync(\"subtitles\", filteredSubtitleResults);\n        blockWebview.channel.sync(\"isSearching\", isSearching);\n        blockWebview.channel.sync(\"searchProviders\", searchProviders);\n        blockWebview.channel.sync(\"selectedUrls\", selectedSubUrls);\n        blockWebview.channel.sync(\"activeSession\", activeSession);\n        blockWebview.channel.sync(\"filterConfig\", filterConfigState);\n        blockWebview.channel.sync(\"pluginConfig\", pluginConfig);\n        blockWebview.channel.sync(\"settings\", settingsState);\n\n        let currentEpisodeNum = \"\";\n        let currentAnimeId = \"\";\n\n        function updateFilterConfig() {\n            filterConfigState.set({\n                lang: filterLang,\n                source: filterSource,\n                format: filterFormat,\n                hi: filterHi,\n                sign: filterSign,\n                honor: filterHonor,\n                fansub: filterFanSub,\n                imdb: filterImdb,\n                season: filterSeason,\n                episode: filterEpisode\n            });\n        }\n\n        // ============================================================\n        // PROVIDER STATUS & PROGRESSIVE HELPERS\n        // ============================================================\n        function setProviderStatus(provider: string, status: boolean) {\n            const wasSearching = isSearching.get();\n            const current = searchProviders.get();\n            const updated = { ...current, [provider]: status };\n            searchProviders.set(updated);\n            const anyActive = Object.values(updated).some(Boolean);\n            isSearching.set(anyActive);\n            if (wasSearching && !anyActive) {\n                ctx.setTimeout(() => afterSearchComplete(), 150);\n            }\n        }\n\n        function clearAllProviderStatus() {\n            searchProviders.set({});\n            isSearching.set(false);\n        }\n\n        function appendResults(newResults: any[]) {\n            if (!newResults || newResults.length === 0) return;\n            const current = subtitleResults.get();\n            subtitleResults.set([...current, ...newResults]);\n            applyFilters();\n            tryAutoSelect();\n            // Resolve fansub levels in the background, then refresh the view.\n            enrichFanSubLevels(newResults);\n        }\n\n        function clearResults() {\n            subtitleResults.set([]);\n            filteredSubtitleResults.set([]);\n            selectedSubUrls.set([]);\n        }\n\n        // ============================================================\n        // INJECT SUBTITLE\n        // ============================================================\n        async function injectSubtitle(sub: any) {\n            try {\n                const data = $habari.parse(sub.media);\n                const label = `${data.release_group ? `[${data.release_group}] ` : ``}${sub.display}${sub.isHearingImpaired ? \" [CC]\" : \"\"}${sub.isSignSongs ? \" [Forced]\" : \"\"}${sub.isHonorifics ? \" [Honorifics]\" : \"\"}${sub.fanSubLevel > 0 ? \" [L\" + sub.fanSubLevel + \" Fansub]\" : \"\"} (${sub.format.toUpperCase()})`;\n                const isXz = typeof sub.url === \"string\" && sub.url.includes(\".xz\");\n              \n                if (isXz) {\n                    const subtitle = await fetchXzText(sub.url);\n                    await ctx.videoCore.addExternalSubtitleTrack({\n                        content: subtitle,\n                        label,\n                        language: sub.language,\n                        type: sub.format.toLowerCase(),\n                    });\n                } else {\n                    await ctx.videoCore.addExternalSubtitleTrack({\n                        src: sub.url,\n                        label,\n                        language: sub.language,\n                        type: sub.format.toLowerCase(),\n                    });\n                }\n                selectedSubUrls.set([...selectedSubUrls.get(), sub.url]);\n            } catch (err) {\n                ctx.toast.error(\"Failed to inject subtitle\", err);\n                console.log(err);\n            }\n        }\n\n        // ============================================================\n        // FILTER LOGIC\n        // ============================================================\n        function applyFiltersTo(subs: any[], fmt: string, lang: string, hi: boolean, sign: boolean, honor: boolean, src: string, fanSub: string) {\n            let filtered = [...subs];\n\n            if (src && src.includes(\"Source\")) {\n                const sourceMap: Record<string, string> = {\n                    \"animetoshoSource\": \"AnimeTosho\",\n                    \"jimakuSource\": \"Jimaku\",\n                    \"tsukihimeSource\": \"TsukiHime\"\n                };\n                const target = sourceMap[src];\n                if (target) filtered = filtered.filter(sub => sub.source === target);\n            }\n\n            if (fmt && fmt !== \"all\") {\n                filtered = filtered.filter(sub => sub.format && sub.format.toLowerCase() === fmt.toLowerCase());\n            }\n            if (lang && lang !== \"all\") {\n                filtered = filtered.filter(sub => sub.language === lang);\n            }\n            if (hi) {\n                filtered = filtered.filter(sub => sub.isHearingImpaired === true);\n            }\n            if (sign) {\n                filtered = filtered.filter(sub => sub.isSignSongs === true);\n            }\n            if (honor) {\n                filtered = filtered.filter(sub => sub.isHonorifics === true);\n            }\n            if (fanSub === \"l0\") {\n              filtered = filtered.filter(sub => {\n                const official = sub.isCR || sub.isNF || sub.isAMZN || sub.isATX || sub.isBili\n                const notFanSub = ![1, 2, 3].includes(sub.fanSubLevel)\n                return Boolean(official) && notFanSub\n              })\n            } else if (fanSub === \"l1\") {\n                filtered = filtered.filter(sub => sub.fanSubLevel === 1);\n            } else if (fanSub === \"l2\") {\n                filtered = filtered.filter(sub => sub.fanSubLevel === 2);\n            } else if (fanSub === \"l3\") {\n                filtered = filtered.filter(sub => sub.fanSubLevel === 3);\n            }\n            return filtered;\n        }\n\n        function applyFilters() {\n            filteredSubtitleResults.set(applyFiltersTo(\n                subtitleResults.get(),\n                filterFormat,\n                filterLang,\n                filterHi,\n                filterSign,\n                filterHonor,\n                filterSource,\n                filterFanSub\n            ));\n        }\n\n        // ============================================================\n        // AUTO-SELECT (tries to select immediately when match found)\n        // ============================================================\n        function tryAutoSelect() {\n            if (!activeSession.get()) return;\n            const autoMode = pluginConfig.get().autoSelect;\n            if (autoMode === \"none\") return;\n            if (autoSelected.get() === currentEpisodeNum) return;\n\n            const candidates = [...subtitleResults.get()];\n            if (candidates.length === 0) return;\n\n            let filtered = applyFiltersTo(candidates, filterFormat, filterLang, filterHi, filterSign, filterHonor, filterSource, filterFanSub);\n\n            if (filtered.length === 0 && autoMode === \"smart\") {\n                if (filterFormat !== \"all\") {\n                    filtered = applyFiltersTo(candidates, \"all\", filterLang, filterHi, filterSign, filterHonor, filterSource, filterFanSub);\n                }\n                if (filtered.length === 0 && filterHi) {\n                    filtered = applyFiltersTo(candidates, filterFormat, filterLang, false, filterSign, filterHonor, filterSource, filterFanSub);\n                }\n                if (filtered.length === 0 && filterSign) {\n                    filtered = applyFiltersTo(candidates, filterFormat, filterLang, filterHi, false, filterHonor, filterSource, filterFanSub);\n                }\n                if (filtered.length === 0 && filterHonor) {\n                    filtered = applyFiltersTo(candidates, filterFormat, filterLang, filterHi, filterSign, false, filterSource, filterFanSub);\n                }\n                if (filtered.length === 0 && filterFanSub !== \"all\") {\n                    filtered = applyFiltersTo(candidates, filterFormat, filterLang, filterHi, filterSign, filterHonor, filterSource, \"all\");\n                }\n            }\n\n            if (filtered.length > 0) {\n                injectSubtitle(filtered[0]);\n                autoSelected.set(currentEpisodeNum);\n            }\n        }\n\n        function afterSearchComplete() {\n            if (!activeSession.get()) return;\n            const autoMode = pluginConfig.get().autoSelect;\n            if (autoMode === \"none\") return;\n            if (autoSelected.get() === currentEpisodeNum) return;\n\n            const candidates = [...subtitleResults.get()];\n            if (candidates.length === 0) {\n                ctx.toast.warning(`${autoMode === \"auto\" ? \"Auto\" : \"Smart\"} Select could not find any subtitles`);\n                autoSelected.set(currentEpisodeNum);\n                return;\n            }\n\n            ctx.toast.warning(`${autoMode === \"auto\" ? \"Auto\" : \"Smart\"} Select could not find any subtitles`);\n            autoSelected.set(currentEpisodeNum);\n        }\n\n        // ============================================================\n        // ANIMETOSHO — PROGRESSIVE\n        // ============================================================\n        async function fetchAnimeTosho(eid: number) {\n            const key = `at-${eid}`;\n            if (lastSearchedKey.get().includes(key)) return;\n            setProviderStatus(\"AnimeTosho\", true);\n\n            try {\n                const url = `${animetoshoAPI}/json?eid=${eid}`;\n                const res = await fetch(url);\n                const allEntries = await res.json();\n\n                const getResValue = (title: string): number => {\n                    if (/\\b2160p\\b|\\b4k\\b/i.test(title)) return 2160;\n                    if (/\\b1440p\\b|\\b2k\\b/i.test(title)) return 1440;\n                    if (/\\b1080p\\b/i.test(title)) return 1080;\n                    if (/\\b720p\\b/i.test(title)) return 720;\n                    if (/\\b480p\\b/i.test(title)) return 480;\n                    return 0;\n                };\n\n                const groups: Record<string, any[]> = {};\n                allEntries.forEach((entry: any) => {\n                    if (entry.title.toLowerCase().includes(\"batch\")) return;\n                    const normalizedTitle = entry.title\n                        .replace(/\\b\\d{3,4}p\\b/gi, \"\")\n                        .replace(/\\b4k\\b|\\b2k\\b/gi, \"\")\n                        .replace(/\\b(?:web-?dl|webrip)\\b/gi, \"\")\n                        .replace(/\\b(?:avc|hevc|x264|x265|h\\.264|h\\.265)\\b/gi, \"\")\n                        .replace(/\\b(?:aac|flac|opus|mp3|dolby|truehd|dts(?:-hd)?(?:\\sma)?)\\b/gi, \"\")\n                        .replace(/[\\[\\(][0-9A-F]{8}[\\]\\)]/gi, \"\")\n                        .replace(/\\s+/g, \" \")\n                        .trim();\n                    if (!groups[normalizedTitle]) groups[normalizedTitle] = [];\n                    groups[normalizedTitle].push(entry);\n                });\n\n                const entries = Object.values(groups).map(group => {\n                    return group.sort((a, b) => getResValue(b.title) - getResValue(a.title))[0];\n                });\n\n                const CONCURRENCY_LIMIT = 5;\n                let index = 0;\n\n                const fetchWithRetry = async (id: number, retries = 2): Promise<any> => {\n                    try {\n                        const tRes = await fetch(`${animetoshoAPI}/json?show=torrent&id=${id}`);\n                        if (tRes.status === 429 && retries > 0) {\n                            await new Promise(r => ctx.setTimeout(r, 1500));\n                            return fetchWithRetry(id, retries - 1);\n                        }\n                        if (!tRes.ok) return null;\n                        return await tRes.json();\n                    } catch (e) {\n                        if (retries > 0) {\n                            await new Promise(r => ctx.setTimeout(r, 1000));\n                            return fetchWithRetry(id, retries - 1);\n                        }\n                        return null;\n                    }\n                };\n\n                const worker = async () => {\n                    while (index < entries.length) {\n                        const entry = entries[index++];\n                        const data = await fetchWithRetry(entry.id);\n                        if (data && data.attachments) {\n                            const batch: any[] = [];\n                            for (const attach of data.attachments) {\n                                if (attach.type !== \"subtitle\") continue;\n                                const providers = detectProvider(attach.info?.language, attach.info?.name, data.title);\n                                const langInfo = resolveLanguage(attach.info?.language_code);\n                                const fanSubLevel = await detectFanSub(data.title);\n                                let language = langInfo.iso2;\n                                let flag = langInfo.countryCode;\n                                const context = (data.title + (attach.info?.name || attach.info?.language)).toLowerCase();\n\n                                if (langInfo.iso2 === \"pt\" && /brazil|\\bbr\\b/i.test(context)) {\n                                    flag = \"BR\"; language = \"br\";\n                                }\n                                if (langInfo.iso2 === \"zh\" && /(\\bzt\\b|traditional)/i.test(context)) {\n                                    flag = \"TW\"; language = \"zt\";\n                                }\n                                if (langInfo.iso2 === \"es\" && /(?:latin[_\\s-]america|latin|america|\\bla\\b|\\blatam\\b)/i.test(context)) {\n                                    flag = \"MX\"; language = \"la\";\n                                }\n\n                                batch.push({\n                                    release: data.title,\n                                    display: langInfo.cleanName,\n                                    language,\n                                    format: attach.info?.format,\n                                    url: attach.url,\n                                    source: \"AnimeTosho\",\n                                    isCR: providers.isCR,\n                                    isNF: providers.isNF,\n                                    isAMZN: providers.isAMZN,\n                                    isATX: providers.isATX,\n                                    isBili: providers.isBili,\n                                    fanSubLevel,\n                                    isHearingImpaired: /\\b(cc|closed? captions?|hi|sdh|hearing impaired)\\b/i.test(attach.info?.name || attach.info?.language),\n                                    isSignSongs: /\\b(forced|signs?|songs?|sign(?:[-_/ ]+)songs?)\\b/i.test(attach.info?.name || attach.info?.language),\n                                    isHonorifics: /honorific/i.test(attach.info?.name || attach.info?.language),\n                                    flagUrl: `https://flagsapi.com/${flag}/flat/64.png`,\n                                    media: data.title\n                                });\n                            }\n                            if (batch.length > 0) appendResults(batch);\n                        }\n                    }\n                };\n\n                await Promise.all(\n                    Array(Math.min(CONCURRENCY_LIMIT, entries.length))\n                        .fill(null)\n                        .map(() => worker())\n                );\n\n                lastSearchedKey.set(key);\n            } catch (err) {\n                console.error(err);\n            } finally {\n                setProviderStatus(\"AnimeTosho\", false);\n            }\n        }\n\n        // ============================================================\n        // JIMAKU — PROGRESSIVE\n        // ============================================================\n        async function fetchJimaku(aniId: number, epNum: number, abEpNum: number, totalEpisodes: number) {\n            const key = `jk-${aniId}-${epNum}`;\n            if (lastSearchedKey.get().includes(key) || !pluginConfig.get().hasJimakuKey) return;\n            setProviderStatus(\"Jimaku\", true);\n\n            try {\n                const searchUrl = `${jimakuAPI}/entries/search?anilist_id=${aniId}`;\n                const searchRes = await fetch(searchUrl, {\n                    headers: { 'Authorization': getSettings().jimakuKey }\n                });\n                if (!searchRes.ok) throw new Error(`Jimaku ID resolution failed: ${searchRes.status}`);\n                const searchData = await searchRes.json();\n                if (!searchData || searchData.length === 0) return;\n\n                const jimakuId = searchData[0].id;\n                const filesUrl = `${jimakuAPI}/entries/${jimakuId}/files`;\n                const filesRes = await fetch(filesUrl, {\n                    headers: { 'Authorization': getSettings().jimakuKey }\n                });\n                if (!filesRes.ok) throw new Error(`Jimaku files fetch failed: ${filesRes.status}`);\n                const filesData = await filesRes.json();\n\n                const results = filesData\n                    .filter((file: any) => {\n                        if (totalEpisodes === 1) return true;\n                        const formatMatch = file.name.match(/\\.([^.]+)$/);\n                        const format = formatMatch ? formatMatch[1] : \"N/A\";\n                        const parsed = $habari.parse(file.name);\n                        const parsedEp = Number(parsed.episode_number);\n                        const ep = epNum || abEpNum;\n                        const validCodecs = [\"ass\", \"ssa\", \"srt\", \"vtt\"];\n                        return parsedEp === Number(ep) && validCodecs.includes(format.toLowerCase());\n                    })\n                    .map((file: any) => {\n                        const formatMatch = file.name.match(/\\.([^.]+)$/);\n                        const format = formatMatch ? formatMatch[1] : \"N/A\";\n                        const providers = detectProvider(file.name);\n                        return {\n                            release: file.name,\n                            display: \"Japanese\",\n                            language: \"ja\",\n                            format: format,\n                            url: file.url,\n                            source: \"Jimaku\",\n                            isCR: providers.isCR,\n                            isNF: providers.isNF,\n                            isAMZN: providers.isAMZN,\n                            isATX: providers.isATX,\n                            isBili: providers.isBili,\n                            isHearingImpaired: /\\b(cc|closed? captions?|hi|sdh|hearing impaired)\\b/i.test(file.name),\n                            isSignSongs: /\\b(forced|signs?|songs?|sign(?:[-_/ ]+)songs?)\\b/i.test(file.name),\n                            isHonorifics: /honorific/i.test(file.name),\n                            flagUrl: `https://flagsapi.com/JP/flat/64.png`,\n                            media: file.name\n                        };\n                    });\n\n                if (results.length > 0) appendResults(results);\n                lastSearchedKey.set(key);\n            } catch (err) {\n                console.error(err);\n            } finally {\n                setProviderStatus(\"Jimaku\", false);\n            }\n        }\n\n        // ============================================================\n        // TSUKIHIME — PROGRESSIVE\n        // ============================================================\n        async function fetchTsukihime(anilistID: number, epNum: number) {\n            const key = `tk-${anilistID}-${epNum}`;\n            if (lastSearchedKey.get().includes(key)) return;\n            setProviderStatus(\"TsukiHime\", true);\n\n            try {\n                const animeRes = await fetch(`${tsukihimeAPI}/animes/anilist/${anilistID}`);\n                if (!animeRes.ok) throw new Error(`Tsukihime anime resolution failed: ${animeRes.status}`);\n                const animeData = await animeRes.json();\n                const tsukihimeAnimeId = animeData.id;\n\n                const epRes = await fetch(`${tsukihimeAPI}/animes/${tsukihimeAnimeId}/episodes/${epNum}`);\n                if (!epRes.ok) throw new Error(`Tsukihime episode fetch failed: ${epRes.status}`);\n                const epData = await epRes.json();\n                const getResValue = (title: string): number => {\n                    if (/\\b2160p\\b|\\b4k\\b/i.test(title)) return 2160;\n                    if (/\\b1440p\\b|\\b2k\\b/i.test(title)) return 1440;\n                    if (/\\b1080p\\b/i.test(title)) return 1080;\n                    if (/\\b720p\\b/i.test(title)) return 720;\n                    if (/\\b480p\\b/i.test(title)) return 480;\n                    return 0;\n                };\n\n                const rawResults = epData.results || [];\n\n                const tkGroups: Record<string, any[]> = {};\n                rawResults.forEach((item: any) => {\n                    const normalizedName = (item.name || \"\")\n                        .replace(/\\b\\d{3,4}p\\b/gi, \"\")\n                        .replace(/\\b4k\\b|\\b2k\\b/gi, \"\")\n                        .replace(/\\b(?:web-?dl|webrip)\\b/gi, \"\")\n                        .replace(/\\b(?:avc|hevc|x264|x265|h\\.264|h\\.265)\\b/gi, \"\")\n                        .replace(/\\b(?:aac|flac|opus|mp3|dolby|truehd|dts(?:-hd)?(?:\\sma)?)\\b/gi, \"\")\n                        .replace(/[\\[\\(][0-9A-F]{8}[\\]\\)]/gi, \"\")\n                        .replace(/\\s+/g, \" \")\n                        .trim();\n                    if (!tkGroups[normalizedName]) tkGroups[normalizedName] = [];\n                    tkGroups[normalizedName].push(item);\n                });\n\n                const resultsList = Object.values(tkGroups).map(group => {\n                    return group.sort((a: any, b: any) => getResValue(b.name || \"\") - getResValue(a.name || \"\"))[0];\n                });\n\n                for (const item of resultsList) {\n                    const releaseName = item.name;\n                    const torrentRes = await fetch(`${tsukihimeAPI}/torrents/${item.id}`);\n                    if (!torrentRes.ok) continue;\n\n                    const torrentData = await torrentRes.json();\n                    const fanSubLevel = await detectFanSub(torrentData.group?.is_fansub);\n                    const files = torrentData.files || [];\n                    const torrentSubs: any[] = [];\n\n                    for (const fileItem of files) {\n                        const attachments = fileItem.attachments || [];\n                        const subAttachments = attachments.filter((attach: any) => attach.type === 1);\n\n                        for (const attach of subAttachments) {\n                            const info = attach.info || {};\n                            const codec = info.codec ? info.codec.toLowerCase() : \"N/A\";\n                            const langCode = info.lang;\n                            const langInfo = resolveLanguage(langCode);\n                            const finalUrl = `${tsukihimeStorage}/attach/${toHex(attach.id)}/${attach.id}.xz`;\n                            const providers = detectProvider(info.name ?? \"\", releaseName);\n\n                            torrentSubs.push({\n                                release: releaseName,\n                                display: langInfo.cleanName,\n                                language: langInfo.iso2,\n                                format: codec,\n                                url: finalUrl,\n                                source: \"TsukiHime\",\n                                isCR: providers.isCR,\n                                isNF: providers.isNF,\n                                isAMZN: providers.isAMZN,\n                                isATX: providers.isATX,\n                                isBili: providers.isBili,\n                                fanSubLevel,\n                                isHearingImpaired: /\\b(cc|closed? captions?|hi|sdh|hearing impaired)\\b/i.test(info.name ?? \"\"),\n                                isSignSongs: /\\b(forced|signs?|songs?|sign(?:[-_/ ]+)songs?)\\b/i.test(info.name ?? \"\"),\n                                isHonorifics: /honorifics?/i.test(info.name ?? \"\"),\n                                flagUrl: `https://flagsapi.com/${langInfo.countryCode}/flat/64.png`,\n                                media: fileItem.name\n                            });\n                        }\n                    }\n                    if (torrentSubs.length > 0) appendResults(torrentSubs);\n                }\n\n                lastSearchedKey.set(key);\n            } catch (err) {\n                console.error(err);\n            } finally {\n                setProviderStatus(\"TsukiHime\", false);\n            }\n        }\n\n        // ============================================================\n        // OPENSUBTITLES\n        // ============================================================\n        async function fetchOpenSubtitles(imdbId: string, season: string, episode: string, isAuto = false) {\n            if (!imdbId) { ctx.toast.warning(\"IMDB ID not found\"); return; }\n            const numericId = imdbId.replace(/^tt/, \"\");\n            const currentKey = `os-${numericId}-${season}-${episode}`;\n            if (isAuto && lastSearchedKey.get().includes(currentKey)) return;\n\n            setProviderStatus(\"OpenSubtitles\", true);\n            try {\n                let searchPath = `/search/imdbid-${numericId}`;\n                if (season && episode) {\n                    searchPath = `/search/episode-${episode}/imdbid-${numericId}/season-${season}`;\n                }\n\n                const res = await fetch(`https://rest.opensubtitles.org${searchPath}`, {\n                    headers: {\n                        \"X-User-Agent\": \"VLSub 0.10.3\",\n                        \"Accept\": \"application/json\"\n                    }\n                });\n\n                if (!res.ok) {\n                    if (res.status !== 404) ctx.toast.error(\"OpenSubtitles search failed\");\n                    return;\n                }\n\n                const data = await res.json();\n                if (!Array.isArray(data)) return;\n\n                const results: any[] = [];\n                const seenIds = new Set<string>();\n\n                for (const entry of data) {\n                    const id = entry.IDSubtitleFile;\n                    if (!id || seenIds.has(id)) continue;\n                    seenIds.add(id);\n\n                    let iso639 = (entry.ISO639 || \"N/A\").toLowerCase();\n                    const langInfo = resolveLanguage(iso639);\n                    const fmt = (entry.SubFormat || \"N/A\").toLowerCase();\n\n                    const rawUrl = entry.SubDownloadLink || \"\";\n                    const url = rawUrl.replace(/\\.gz$/, \"\") + \".\" + fmt;\n\n                    const displayName = entry.LanguageName || langInfo.cleanName || iso639.toUpperCase();\n                    const providers = detectProvider(entry.MovieReleaseName || \"\");\n                    const fanSubLevel = await detectFanSub(entry.MovieReleaseName)\n\n                    let flag = langInfo.countryCode || \"N/A\";\n                    if (iso639 === \"ea\") { flag = \"MX\"; iso639 = \"la\";}\n\n                    results.push({\n                        release: entry.SubFileName || entry.MovieReleaseName,\n                        display: displayName.replace(/\\s*\\([^)]*\\)/g, \"\"),\n                        language: iso639,\n                        format: fmt,\n                        url,\n                        source: \"OpenSubtitles\",\n                        isCR: providers.isCR,\n                        isNF: providers.isNF,\n                        isAMZN: providers.isAMZN,\n                        isATX: providers.isATX,\n                        isBili: providers.isBili,\n                        fanSubLevel,\n                        isHearingImpaired: entry.SubHearingImpaired === \"1\" || /\\b(cc|closed? captions?|hi|sdh|hearing impaired)\\b/i.test(entry.SubFileName) || /\\b(cc|closed? captions?|hi|sdh|hearing impaired)\\b/i.test(entry.MovieReleaseName) || /\\b(cc|closed? captions?|hi|sdh|hearing impaired)\\b/i.test(entry.SubAuthorComment),\n                        isSignSongs: /\\b(forced|signs?|songs?|sign(?:[-_/ ]+)songs?)\\b/i.test(entry.SubFileName) || /\\b(forced|signs?|songs?|sign(?:[-_/ ]+)songs?)\\b/i.test(entry.MovieReleaseName) || /\\b(forced|signs?|songs?|sign(?:[-_/ ]+)songs?)\\b/i.test(entry.SubAuthorComment),\n                        isHonorifics: /honorific/i.test(entry.SubFileName) || /honorific/i.test(entry.MovieReleaseName) || /honorific/i.test(entry.SubAuthorComment),\n                        flagUrl: `https://flagsapi.com/${flag}/flat/64.png`,\n                        media: entry.SubFileName || entry.MovieReleaseName\n                    });\n                }\n\n                if (results.length > 0) appendResults(results);\n                lastSearchedKey.set(currentKey);\n            } catch (err) {\n                console.log(err)\n                ctx.toast.error(\"OpenSubtitles search failed\");\n            } finally {\n                setProviderStatus(\"OpenSubtitles\", false);\n            }\n        }\n\n        // ============================================================\n        // LOAD MEDIA DATA (ORCHESTRATOR)\n        // ============================================================\n        async function loadMediaData(anilistId: number) {\n            try {\n                const metadata = await ctx.anime.getAnimeMetadata(\"anilist\", anilistId);\n                const info = await ctx.videoCore.getCurrentPlaybackInfo();\n                const mappingImdb = metadata.mappings?.imdbId?.toString();\n                const mappingTmdb = metadata.mappings?.themoviedbId?.toString();\n                const currentSeason = metadata.episodes[\"1\"]?.seasonNumber?.toString();\n                const currentEpisode = info.episode?.episodeNumber?.toString();\n                const absoluteEpisode = info.episode?.absoluteEpisodeNumber?.toString();\n                const totalEpisodes = info.media?.episodes?.toString();\n                const eid = metadata.episodes[currentEpisode]?.anidbId?.toString();\n                const currentFormat = info.media?.format?.toUpperCase();\n                const anidbId = metadata.mappings.anidbId;\n\n                const sessionKey = `${anilistId}-${currentEpisode}`;\n                \n                if (currentAnimeId === anilistId.toString() && currentEpisodeNum === currentEpisode) {\n                    return;\n                }\n\n                currentEpisodeNum = currentEpisode || \"\";\n                currentAnimeId = anilistId.toString();\n                clearResults();\n                clearAllProviderStatus();\n                lastSearchedKey.set(\"\");\n                autoSelected.set(\"\");\n                updateFilterConfig();\n\n                if (filterSource.includes(\"Source\")) {\n                    const promises: Promise<void>[] = [];\n                    \n                    if (filterSource === \"animetoshoSource\" && eid) {\n                        promises.push(fetchAnimeTosho(parseInt(eid)));\n                    } else if (filterSource === \"jimakuSource\") {\n                        promises.push(fetchJimaku(anilistId, parseInt(currentEpisode || \"0\"), parseInt(absoluteEpisode || \"0\"), parseInt(totalEpisodes || \"0\")));\n                    } else if (filterSource === \"tsukihimeSource\") {\n                        promises.push(fetchTsukihime(anilistId, parseInt(currentEpisode || \"0\")));\n                    }\n                    \n                    await Promise.all(promises);\n                    return;\n                }\n\n                const title = info.media.title.english ?? info.media.title.romaji ?? info.media.title.userPreferred;\n                const isMovie = currentFormat === \"MOVIE\";\n                \n                const resolvedIds = await resolveIds(anilistId, isMovie, title, parseInt(currentSeason || \"1\"));\n                \n                filterImdb = resolvedIds.imdbId;\n                filterSeason = resolvedIds.season.toString();\n                filterEpisode = currentEpisode;\n\n                updateFilterConfig();\n                if (filterImdb) {\n                    if (filterSource === \"opensubtitles\") {\n                        await fetchOpenSubtitles(filterImdb, filterSeason, filterEpisode, true);\n                    }\n                }\n            } catch (e) {\n                console.error(\"Mapping error\", e);\n            }\n        }\n\n        // ============================================================\n        // ID RESOLUTION HELPERS\n        // ============================================================\n        async function ensureIdMap(): Promise<Record<number, { t?: number; i?: string; s: number }>> {\n            const resp = await fetch(ANIMELIST_URL);\n            const list = await resp.json() as any[];\n            const map: Record<number, { t?: number; i?: string; s: number }> = {};\n\n            for (const item of list) {\n                if (!item.anilist_id) continue;\n                if (!item.themoviedb_id && !item.imdb_id) continue;\n                map[item.anilist_id] = {\n                    t: item.themoviedb_id ?? 0,\n                    i: item.imdb_id ?? \"\",\n                    tmdbSeason: item.season?.tmdb ?? 1,\n                    tvdbSeason: item.season?.tvdb ?? 1,\n                };\n            }\n\n            return map;\n        }\n\n        async function resolveIds(anilistId: number, isMovie: boolean, title: string, tmdbSeason: number): Promise<{ tmdbId: number; imdbId: string; season: number }> {\n            const idMap = await ensureIdMap();\n            const idEntry = idMap[anilistId];\n\n            let tmdbId = idEntry?.t ?? 0;\n            let imdbId = idEntry?.i ?? \"\";\n            let season = idEntry?.tmdbSeason ?? tmdbSeason;\n\n            const apiKeys = [\n                'fb7bb23f03b6994dafc674c074d01761',\n                'e55425032d3d0f371fc776f302e7c09b',\n                '8301a21598f8b45668d5711a814f01f6',\n                '8cf43ad9c085135b9479ad5cf6bbcbda',\n                'da63548086e399ffc910fbc08526df05',\n                '13e53ff644a8bd4ba37b3e1044ad24f3',\n                '269890f657dddf4635473cf4cf456576',\n                'a2f888b27315e62e471b2d587048f32e',\n                '8476a7ab80ad76f0936744df0430e67c',\n                '5622cafbfe8f8cfe358a29c53e19bba0',\n                'ae4bd1b6fce2a5648671bfc171d15ba4',\n                '257654f35e3dff105574f97fb4b97035',\n                '2f4038e83265214a0dcd6ec2eb3276f5',\n                '9e43f45f94705cc8e1d5a0400d19a7b7',\n                'af6887753365e14160254ac7f4345dd2',\n                '06f10fc8741a672af455421c239a1ffc',\n                'fb7bb23f03b6994dafc674c074d01761',\n                '09ad8ace66eec34302943272db0e8d2c'\n            ];\n            const apiKey = apiKeys[Math.floor(Math.random() * apiKeys.length)];\n\n            if (!tmdbId) {\n                try {\n                    const tmdbRes = await fetch(`${TMDB_API_BASE}/search/${isMovie ? \"movie\" : \"tv\"}?query=${encodeURIComponent(title)}&api_key=${apiKey}`);\n                    const tmdbJson = await tmdbRes.json();\n                    if (tmdbJson.results && tmdbJson.results.length > 0) {\n                        tmdbId = tmdbJson.results[0].id;\n                    }\n                } catch (e) {\n                    console.error(\"TMDB search failed\", e);\n                }\n            }\n\n            if (!imdbId && tmdbId) {\n                try {\n                    const imdbRes = await fetch(`${TMDB_API_BASE}/${isMovie ? \"movie\" : \"tv\"}/${tmdbId}?api_key=${apiKey}&append_to_response=external_ids`);\n                    const imdbJson = await imdbRes.json();\n                    imdbId = imdbJson.external_ids?.imdb_id ?? \"\";\n                } catch (e) {\n                    console.error(\"IMDB resolution failed\", e);\n                }\n            }\n\n            return { tmdbId, imdbId, season };\n        }\n\n        // ============================================================\n        // UTILITIES\n        // ============================================================\n        function toHex(id: any) {\n            const hexId = Number(id).toString(16).toLowerCase();\n            return hexId.padStart(8, '0');\n        }\n\n        function detectProvider(...names: string[]) {\n            const providers = {\n                isCR: /(?:^|[^A-Za-z0-9])(CR|Crunchyroll)(?:[^A-Za-z0-9]|$)/i,\n                isNF: /(?:^|[^A-Za-z0-9])(NF|Netflix)(?:[^A-Za-z0-9]|$)/i,\n                isAMZN: /(?:^|[^A-Za-z0-9])(AMZ|AMZN|Amazon)(?:[^A-Za-z0-9]|$)/i,\n                isATX: /(?:^|[^A-Za-z0-9])(ATX|AT-X)(?:[^A-Za-z0-9]|$)/i,\n                isBili: /(?:^|[^A-Za-z0-9])(Bili|BiliBili)(?:[^A-Za-z0-9]|$)/i\n            };\n        \n            const combinedName = names.filter(Boolean).join(\" \");\n        \n            const topMatches = Object.entries(providers)\n                .map(([key, regex]) => ({ key, index: combinedName.search(regex) }))\n                .filter(match => match.index !== -1)\n                .sort((a, b) => a.index - b.index)\n                .slice(0, 2)\n                .map(match => match.key);\n        \n            return {\n                isCR: topMatches.includes(\"isCR\"),\n                isNF: topMatches.includes(\"isNF\"),\n                isAMZN: topMatches.includes(\"isAMZN\"),\n                isATX: topMatches.includes(\"isATX\"),\n                isBili: topMatches.includes(\"isBili\")\n            };\n        }\n\n        // ============================================================\n        // FANSUB LEVEL DETECTION (nekobt.to release groups)\n        // ============================================================\n        const nekobtGroupPromises = new Map<string, Promise<any[]>>();\n\n        // Resolves an AniList id to a nekobt media id and returns its release\n        // groups (each with display_tag + max_level). Cached per anime.\n        function getFanSubGroups(aniID: number): Promise<any[]> {\n            const key = String(aniID);\n            if (!nekobtGroupPromises.has(key)) {\n                nekobtGroupPromises.set(key, (async () => {\n                    try {\n                        const resolveRes = await fetch(`https://nekobt.to/api/v1/media/resolve?id=anilist-${aniID}`);\n                        if (!resolveRes.ok) return [];\n                        const resolved = await resolveRes.json();\n                        const mediaId = resolved?.data?.media_id;\n                        if (!mediaId) return [];\n                        const mediaRes = await fetch(`https://nekobt.to/api/v1/media/${mediaId}`);\n                        if (!mediaRes.ok) return [];\n                        const media = await mediaRes.json();\n                        return media?.data?.groups || [];\n                    } catch (err) {\n                        console.error(\"[subtitle-engine] nekobt lookup failed\", err);\n                        return [];\n                    }\n                })());\n            }\n            return nekobtGroupPromises.get(key)!;\n        }\n\n        const tsukihimeGroupPromises = new Map<string, Promise<any[]>>();\n\n        // Resolves an AniList id to a tsukihime anime id and returns its groups\n        // (each with name + is_fansub). Cached per anime.\n        function getTsukihimeGroups(aniID: number): Promise<any[]> {\n            const key = String(aniID);\n            if (!tsukihimeGroupPromises.has(key)) {\n                tsukihimeGroupPromises.set(key, (async () => {\n                    try {\n                        const animeRes = await fetch(`${tsukihimeAPI}/animes/anilist/${aniID}`);\n                        if (!animeRes.ok) return [];\n                        const anime = await animeRes.json();\n                        const tkId = anime?.id;\n                        if (!tkId) return [];\n                        const groupsRes = await fetch(`${tsukihimeAPI}/animes/${tkId}/groups?limit=40&offset=0&sort=count_desc`);\n                        if (!groupsRes.ok) return [];\n                        const groups = await groupsRes.json();\n                        return groups?.results || [];\n                    } catch (err) {\n                        console.error(\"[subtitle-engine] tsukihime groups lookup failed\", err);\n                        return [];\n                    }\n                })());\n            }\n            return tsukihimeGroupPromises.get(key)!;\n        }\n\n        function normGroupTag(s: string): string {\n            return (s || \"\").toLowerCase().replace(/[^a-z0-9]/g, \"\");\n        }\n\n        function parseReleaseGroup(name: string): string {\n            if (!name) return \"\";\n            try {\n                const parsed = $habari.parse(name);\n                return parsed?.release_group || \"\";\n            } catch (err) { /* not a release name */ }\n            return \"\";\n        }\n\n        // nekobt groups: return the matched group's max_level.\n        function matchNekobtGroup(groups: any[], releaseGroup: string): { matched: boolean; level: number } {\n            const target = normGroupTag(releaseGroup);\n            if (!groups || groups.length === 0 || !target) return { matched: false, level: 0 };\n            const match = groups.find((g: any) =>\n                normGroupTag(g.display_tag) === target ||\n                normGroupTag(g.display_name) === target ||\n                normGroupTag(g.tag) === target\n            );\n            if (!match) return { matched: false, level: 0 };\n            return { matched: true, level: typeof match.max_level === \"number\" ? match.max_level : 0 };\n        }\n\n        // tsukihime groups: a fansub match is level 3, otherwise 0.\n        function matchTsukihimeGroup(groups: any[], releaseGroup: string): { matched: boolean; level: number } {\n            const target = normGroupTag(releaseGroup);\n            if (!groups || groups.length === 0 || !target) return { matched: false, level: 0 };\n            const match = groups.find((g: any) => normGroupTag(g.name) === target);\n            if (!match) return { matched: false, level: 0 };\n            return { matched: true, level: match.is_fansub ? 3 : 0 };\n        }\n\n        async function detectFanSub(aniID: number, name: string): Promise<number> {\n            if (!aniID || !name) return 0;\n            const releaseGroup = parseReleaseGroup(name);\n            if (!releaseGroup) return 0;\n\n            // 1) Prefer nekobt. If a group matched (even at level 0), stop here.\n            const nekobtGroups = await getFanSubGroups(aniID);\n            const nb = matchNekobtGroup(nekobtGroups, releaseGroup);\n            if (nb.matched) return nb.level;\n\n            // 2) Only when no nekobt group matched at all, fall back to tsukihime.\n            const tsukihimeGroups = await getTsukihimeGroups(aniID);\n            const tk = matchTsukihimeGroup(tsukihimeGroups, releaseGroup);\n            return tk.matched ? tk.level : 0;\n        }\n\n        