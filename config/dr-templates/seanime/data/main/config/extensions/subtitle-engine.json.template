;\n        }\n        .select-btn.rippling::after { animation: se-ripple 0.45s ease-out; }\n        @keyframes se-ripple {\n            0% { opacity: 1; transform: scale(0.2); }\n            100% { opacity: 0; transform: scale(2.4); }\n        }\n        .select-btn.loading {\n            color: var(--se-fg);\n            cursor: default;\n            background: var(--se-subtle);\n        }\n        .select-btn .inject-spinner { width: 18px; height: 18px; display: block; flex: none; animation: se-spin 0.7s linear infinite; transform-origin: 50% 50%; }\n        @keyframes se-spin { to { transform: rotate(360deg); } }\n        .select-btn .check-pop { animation: se-pop 0.28s cubic-bezier(0.34, 1.56, 0.64, 1); transform-origin: 50% 50%; }\n        @keyframes se-pop { 0% { transform: scale(0.3); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }\n        .select-btn.added {\n            cursor: default;\n            color: var(--se-brand);\n            background: rgba(97, 82, 223, 0.15);\n            border-color: rgba(159, 146, 255, 0.2);\n        }\n\n        /* ==========================================================================\n           Empty / loading states\n           ========================================================================== */\n        .empty-state { text-align: center; padding: 48px 20px; color: var(--se-muted); }\n        .spinner {\n            width: 32px;\n            height: 32px;\n            border: 3px solid rgba(255, 255, 255, 0.1);\n            border-top-color: var(--se-brand);\n            border-radius: 50%;\n            animation: spin 0.9s linear infinite;\n            margin: 0 auto 14px;\n        }\n        @keyframes spin { to { transform: rotate(360deg); } }\n\n        /* ==========================================================================\n           Icon buttons\n           ========================================================================== */\n        .refresh-btn, .settings-btn, .close-btn, .settings-close {\n            width: 32px;\n            height: 32px;\n            padding: 0;\n            border-radius: var(--se-radius);\n            display: inline-flex;\n            align-items: center;\n            justify-content: center;\n            background: transparent;\n            border: 1px solid transparent;\n            color: var(--se-muted);\n            cursor: pointer;\n            font-family: inherit;\n            transition: background 0.15s, color 0.15s;\n        }\n        .refresh-btn:hover, .settings-btn:hover, .close-btn:hover, .settings-close:hover {\n            background: var(--se-subtle);\n            color: #fff;\n        }\n\n        /* ==========================================================================\n           Settings modal\n           ========================================================================== */\n        .settings-overlay {\n            position: fixed;\n            inset: 0;\n            z-index: 60;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            padding: 24px;\n            background: rgba(0, 0, 0, 0.8);\n            backdrop-filter: blur(3px);\n            -webkit-backdrop-filter: blur(3px);\n            animation: seFadeIn 0.15s ease;\n        }\n        .settings-panel {\n            width: 560px;\n            max-width: 100%;\n            max-height: min(84vh, 760px);\n            display: flex;\n            flex-direction: column;\n            overflow: hidden;\n            background: var(--se-paper);\n            border: 1px solid rgba(255, 255, 255, 0.05);\n            border-radius: 16px;\n            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.65);\n            animation: seZoomIn 0.18s cubic-bezier(0.22, 1, 0.36, 1);\n        }\n        .settings-scroll { flex: 1; min-height: 0; overflow-y: auto; padding: 0 24px 8px; }\n        .settings-scroll::-webkit-scrollbar { width: 6px; }\n        .settings-scroll::-webkit-scrollbar-track { background: transparent; }\n        .settings-scroll::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.15); border-radius: 3px; }\n\n        .settings-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            padding: 20px 0 14px;\n            margin-bottom: 16px;\n            border-bottom: 1px solid var(--se-border);\n        }\n        .settings-title { font-size: 18px; font-weight: 600; letter-spacing: -0.01em; color: var(--se-fg-strong); }\n\n        .settings-section { margin-bottom: 22px; }\n        .settings-section-title { font-size: 13px; font-weight: 600; color: var(--se-fg); margin-bottom: 10px; }\n        .settings-section-header {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            cursor: pointer;\n            user-select: none;\n            padding: 4px 0;\n            margin-bottom: 8px;\n        }\n        .settings-section-header .settings-section-title { margin-bottom: 0; }\n        .section-chevron { color: var(--se-muted); transition: transform 0.2s; }\n        .section-chevron.expanded { transform: rotate(180deg); }\n        .keys-needed-badge {\n            display: inline-flex;\n            align-items: center;\n            height: 18px;\n            padding: 0 6px;\n            margin-left: 8px;\n            border-radius: 100px;\n            font-size: 10px;\n            font-weight: 600;\n            color: rgb(253 186 116);\n            background: rgba(249, 115, 22, 0.1);\n            border: 1px solid rgba(249, 115, 22, 0.4);\n        }\n\n        .settings-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 6px 0; }\n        .settings-row label { font-size: 13px; color: var(--se-muted-highlight); flex-shrink: 0; }\n        .settings-row input, .settings-row select {\n            flex: 1;\n            max-width: 240px;\n            height: 36px;\n            background: transparent;\n            border: 1px solid var(--se-border);\n            border-radius: var(--se-radius);\n            color: var(--se-fg-strong);\n            padding: 0 10px;\n            font-size: 13px;\n            font-family: inherit;\n            outline: none;\n            transition: background 0.15s, border-color 0.15s;\n        }\n        .settings-row input:hover, .settings-row select:hover { background: var(--se-subtle); }\n        .settings-row input:focus, .settings-row select:focus { background: var(--se-subtle); border-color: rgba(212, 208, 255, 0.4); }\n        .settings-row option { background: var(--se-menu); color: var(--se-fg); }\n\n        .settings-save {\n            flex: none;\n            width: calc(100% - 48px);\n            margin: 8px 24px 20px;\n            height: 40px;\n            border-radius: 10px;\n            border: 1px solid rgba(159, 146, 255, 0.2);\n            background: rgba(97, 82, 223, 0.7);\n            color: #fff;\n            font-size: 14px;\n            font-weight: 600;\n            font-family: inherit;\n            cursor: pointer;\n            transition: background 0.15s, transform 0.15s;\n        }\n        .settings-save:hover { background: rgba(97, 82, 223, 0.9); }\n        .settings-save:active { transform: scale(0.99); }\n\n        .key-input-wrap { position: relative; flex: 1; max-width: 240px; }\n        .key-input-wrap input { padding-right: 34px; width: 100%; max-width: none; }\n        .key-eye-btn {\n            position: absolute;\n            right: 4px;\n            top: 50%;\n            transform: translateY(-50%);\n            width: 28px;\n            height: 28px;\n            background: transparent;\n            border: none;\n            border-radius: 6px;\n            color: var(--se-muted);\n            cursor: pointer;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            opacity: 0;\n            transition: opacity 0.15s, color 0.15s, background 0.15s;\n        }\n        .key-input-wrap:hover .key-eye-btn,\n        .key-input-wrap:focus-within .key-eye-btn { opacity: 1; }\n        .key-eye-btn:hover { color: #fff; background: var(--se-subtle); }\n\n    </style>\n</head>\n<body>\n    <div id=\"app\"></div>\n    <script type=\"module\">\n        import { h, render } from \"https://esm.sh/preact@10.19.3\"\n        import { useState, useEffect } from \"https://esm.sh/preact@10.19.3/hooks\"\n        import htm from \"https://esm.sh/htm@3.1.1\"\n        const html = htm.bind(h)\n\n        const EYE_OPEN_SVG = '<svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"currentColor\"><path d=\"M2.98444 8.62471L2.98346 8.62815C2.91251 8.8948 2.63879 9.05404 2.37202 8.9833C1.94098 8.86907 2.01687 8.37186 2.01687 8.37186L2.03453 8.31047C2.03453 8.31047 2.06063 8.22636 2.08166 8.1653C2.12369 8.04329 2.18795 7.87274 2.27931 7.66977C2.46154 7.26493 2.75443 6.72477 3.19877 6.18295C4.09629 5.08851 5.60509 4 8.00017 4C10.3952 4 11.904 5.08851 12.8016 6.18295C13.2459 6.72477 13.5388 7.26493 13.721 7.66977C13.8124 7.87274 13.8766 8.04329 13.9187 8.1653C13.9397 8.22636 13.9552 8.27541 13.9658 8.31047C13.9711 8.328 13.9752 8.34204 13.9781 8.35236L13.9816 8.365L13.9827 8.36916L13.9832 8.37069L13.9835 8.37186C14.0542 8.63878 13.8952 8.91253 13.6283 8.9833C13.3618 9.05397 13.0885 8.89556 13.0172 8.62937L13.0169 8.62815L13.0159 8.62471L13.0085 8.5997C13.0014 8.57616 12.9898 8.53927 12.9732 8.49095C12.9399 8.39422 12.8866 8.25227 12.8091 8.08023C12.6538 7.73508 12.4041 7.27523 12.0283 6.81706C11.2857 5.9115 10.0445 5 8.00017 5C5.95584 5 4.71464 5.9115 3.97201 6.81706C3.59627 7.27523 3.34655 7.73508 3.19119 8.08023C3.11375 8.25227 3.06047 8.39422 3.02715 8.49095C3.01051 8.53927 2.9989 8.57616 2.99179 8.5997L2.98444 8.62471ZM8.00024 7C6.61953 7 5.50024 8.11929 5.50024 9.5C5.50024 10.8807 6.61953 12 8.00024 12C9.38096 12 10.5002 10.8807 10.5002 9.5C10.5002 8.11929 9