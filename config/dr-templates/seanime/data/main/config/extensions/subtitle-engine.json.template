lumn; gap: 6px; }\n        .filter-group label { font-size: 13px; font-weight: 500; color: var(--se-muted); padding-left: 1px; }\n\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            justify-content: center;\n            gap: 8px;\n            height: 36px;\n            padding: 0 16px;\n            border-radius: var(--se-radius);\n            border: 1px solid transparent;\n            background: transparent;\n            color: var(--se-fg-strong);\n            font-size: 13.5px;\n            font-weight: 500;\n            font-family: inherit;\n            white-space: nowrap;\n            cursor: pointer;\n            transition: background 0.15s, border-color 0.15s, color 0.15s, transform 0.15s;\n        }\n        .btn:hover { transform: scale(1.01); }\n        .btn:active { transform: scale(0.98); }\n        .btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }\n        .btn-primary {\n            background: rgba(97, 82, 223, 0.7);\n            border-color: rgba(159, 146, 255, 0.2);\n            color: #fff;\n        }\n        .btn-primary:hover:not(:disabled) { background: rgba(97, 82, 223, 0.9); }\n        .btn-primary:active:not(:disabled) { background: rgb(97 82 223); }\n\n        /* ==========================================================================\n           Alerts (Seanime Alert anatomy, dark intents)\n           ========================================================================== */\n        .alert {\n            display: flex;\n            justify-content: space-between;\n            padding: 12px 16px;\n            border-radius: 12px;\n            border: 1px solid var(--se-border);\n            margin-bottom: 16px;\n            font-size: 14px;\n            line-height: 1.5;\n            color: var(--se-fg);\n            transition: background 0.2s;\n        }\n        .alert-details { display: flex; width: 100%; align-items: flex-start; }\n        .alert-icon { display: flex; flex: none; align-self: flex-start; margin-top: 2px; }\n        .alert-icon svg { width: 20px; height: 20px; }\n        .alert-text { display: flex; flex-direction: column; align-self: flex-start; margin-left: 12px; gap: 2px; }\n        .alert-title { font-weight: 600; font-size: 14px; color: var(--se-fg); margin-bottom: 2px; line-height: 1.3; }\n        .alert-desc { font-size: 13px; color: var(--se-fg); line-height: 1.5; }\n        .alert-info { background: rgba(30, 58, 138, 0.3); }\n        .alert-info .alert-icon { color: #60a5fa; }\n        .alert-warning { background: rgba(124, 45, 18, 0.3); }\n        .alert-warning .alert-icon { color: #fb923c; }\n        .alert-error { background: rgba(127, 29, 29, 0.3); }\n        .alert-error .alert-icon { color: #f87171; }\n\n        /* ==========================================================================\n           Results list\n           ========================================================================== */\n        .subtitle-list-wrapper { min-height: 0; }\n        .subtitle-list { display: flex; flex-direction: column; gap: 2px; padding-bottom: 4px; }\n        .sub-item {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            gap: 12px;\n            padding: 10px 12px;\n            border-radius: var(--se-radius);\n            border: 1px solid transparent;\n            transition: background 0.12s ease;\n            animation: fade-in 0.25s ease;\n        }\n        .sub-item:hover { background: var(--se-subtle); }\n        @keyframes fade-in {\n            from { opacity: 0; transform: translateY(4px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        .sub-info { flex: 1; min-width: 0; }\n        .sub-release {\n            font-size: 14px;\n            font-weight: 500;\n            color: var(--se-fg);\n            white-space: nowrap;\n            overflow: hidden;\n            text-overflow: ellipsis;\n            margin-bottom: 7px;\n        }\n        .sub-item:hover .sub-release { color: #fff; }\n        .sub-meta { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }\n\n        .lang-tag {\n            display: inline-flex;\n            align-items: center;\n            gap: 6px;\n            height: 22px;\n            padding: 0 8px;\n            border-radius: 100px;\n            font-size: 11.5px;\n            font-weight: 600;\n            letter-spacing: 0.02em;\n            color: rgb(202 202 202);\n            background: rgba(150, 150, 150, 0.2);\n            border: 1px solid rgba(150, 150, 150, 0.4);\n        }\n        .flag { width: 16px; height: 11px; object-fit: cover; border-radius: 2px; display: block; }\n\n        .meta-badge {\n            display: inline-flex;\n            align-items: center;\n            height: 20px;\n            padding: 0 8px;\n            border-radius: 100px;\n            font-size: 11px;\n            font-weight: 600;\n            letter-spacing: 0.02em;\n            border: 1px solid;\n        }\n        .badge-cr { color: rgb(253 186 116); background: rgba(249, 115, 22, 0.1); border-color: rgba(249, 115, 22, 0.4); }\n        .badge-nf { color: rgb(252 165 165); background: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.4); }\n        .badge-amzn { color: rgb(147 197 253); background: rgba(59, 130, 246, 0.1); border-color: rgba(59, 130, 246, 0.4); }\n        .badge-atx { color: rgb(252 165 165); background: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.4); }\n        .badge-bili { color: rgb(125 211 252); background: rgba(14, 165, 233, 0.1); border-color: rgba(14, 165, 233, 0.4); }\n        .badge-fansub { color: rgb(165 180 252); background: rgba(99, 102, 241, 0.1); border-color: rgba(99, 102, 241, 0.4); }\n        .badge-fansub.l1 { color: rgb(202 202 202); background: rgba(150, 150, 150, 0.15); border-color: rgba(150, 150, 150, 0.4); }\n        .badge-fansub.l2 { color