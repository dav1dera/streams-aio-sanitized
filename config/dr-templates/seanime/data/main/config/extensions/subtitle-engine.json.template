6493 13.2459 6.72477 12.8016 6.18295C11.904 5.0885 10.3952 4 8.00017 4C7.38264 4 6.82403 4.07236 6.31962 4.19853Z\"/></svg>';\n\n        const SOURCE_OPTIONS = [\n            { label: \"AnimeTosho\", value: \"animetoshoSource\" },\n            { label: \"Jimaku\", value: \"jimakuSource\" },\n            { label: \"TsukiHime\", value: \"tsukihimeSource\" },\n            { label: \"OpenSubtitles\", value: \"opensubtitles\" }\n        ];\n\n        const LANG_OPTIONS = [\n            { label: \"All\", value: \"all\" },\n            { label: \"English\", value: \"en\" },\n            { label: \"Spanish (ES)\", value: \"es\" },\n            { label: \"Spanish (LA)\", value: \"la\" },\n            { label: \"French\", value: \"fr\" },\n            { label: \"German\", value: \"de\" },\n            { label: \"Italian\", value: \"it\" },\n            { label: \"Portuguese (PT)\", value: \"pt\" },\n            { label: \"Portuguese (BR)\", value: \"br\" },\n            { label: \"Japanese\", value: \"ja\" },\n            { label: \"Korean\", value: \"ko\" },\n            { label: \"Chinese (Simplified)\", value: \"zh\" },\n            { label: \"Chinese (Traditional)\", value: \"zt\" },\n            { label: \"Russian\", value: \"ru\" },\n            { label: \"Arabic\", value: \"ar\" },\n            { label: \"Turkish\", value: \"tr\" },\n            { label: \"Indonesian\", value: \"id\" },\n            { label: \"Vietnamese\", value: \"vi\" },\n            { label: \"Thai\", value: \"th\" },\n            { label: \"Hindi\", value: \"hi\" },\n            { label: \"Bengali\", value: \"bn\" },\n            { label: \"Malay\", value: \"ms\" },\n            { label: \"Tagalog\", value: \"tl\" },\n            { label: \"Persian\", value: \"fa\" },\n            { label: \"Hebrew\", value: \"he\" },\n            { label: \"Polish\", value: \"pl\" },\n            { label: \"Dutch\", value: \"nl\" },\n            { label: \"Greek\", value: \"el\" },\n            { label: \"Czech\", value: \"cs\" },\n            { label: \"Hungarian\", value: \"hu\" },\n            { label: \"Romanian\", value: \"ro\" },\n            { label: \"Swedish\", value: \"sv\" },\n            { label: \"Danish\", value: \"da\" },\n            { label: \"Finnish\", value: \"fi\" },\n            { label: \"Norwegian\", value: \"no\" },\n            { label: \"Ukrainian\", value: \"uk\" },\n            { label: \"Bulgarian\", value: \"bg\" },\n            { label: \"Slovak\", value: \"sk\" },\n            { label: \"Croatian\", value: \"hr\" },\n            { label: \"Serbian\", value: \"sr\" },\n            { label: \"Slovenian\", value: \"sl\" },\n            { label: \"Lithuanian\", value: \"lt\" },\n            { label: \"Latvian\", value: \"lv\" },\n            { label: \"Estonian\", value: \"et\" },\n            { label: \"Icelandic\", value: \"is\" },\n            { label: \"Albanian\", value: \"sq\" },\n            { label: \"Armenian\", value: \"hy\" },\n            { label: \"Azerbaijani\", value: \"az\" },\n            { label: \"Basque\", value: \"eu\" },\n            { label: \"Belarusian\", value: \"be\" },\n            { label: \"Bosnian\", value: \"bs\" },\n            { label: \"Catalan\", value: \"ca\" },\n            { label: \"Galician\", value: \"gl\" },\n            { label: \"Georgian\", value: \"ka\" },\n            { label: \"Gujarati\", value: \"gu\" },\n            { label: \"Kazakh\", value: \"kk\" },\n            { label: \"Khmer\", value: \"km\" },\n            { label: \"Macedonian\", value: \"mk\" },\n            { label: \"Malayalam\", value: \"ml\" },\n            { label: \"Marathi\", value: \"mr\" },\n            { label: \"Mongolian\", value: \"mn\" },\n            { label: \"Nepali\", value: \"ne\" },\n            { label: \"Punjabi\", value: \"pa\" },\n            { label: \"Sinhala\", value: \"si\" },\n            { label: \"Tamil\", value: \"ta\" },\n            { label: \"Telugu\", value: \"te\" },\n            { label: \"Urdu\", value: \"ur\" },\n            { label: \"Uzbek\", value: \"uz\" },\n            { label: \"Welsh\", value: \"cy\" }\n        ];\n\n        const FORMAT_OPTIONS = [\n            { label: \"All\", value: \"all\" },\n            { label: \"ASS\", value: \"ass\" },\n            { label: \"SSA\", value: \"ssa\" },\n            { label: \"SRT\", value: \"srt\" },\n            { label: \"VTT\", value: \"vtt\" }\n        ];\n\n        const FANSUB_OPTIONS = [\n            { label: \"All\", value: \"all\" },\n            { label: \"L0 (Official)\", value: \"l0\" },\n            { label: \"L1 (Slight Modifications)\", value: \"l1\" },\n            { label: \"L2 (Small-scale Fansubs)\", value: \"l2\" },\n            { label: \"L3 (Full-scale Fansubs)\", value: \"l3\" }\n        ];\n\n        const AUTO_SELECT_OPTIONS = [\n            { label: \"Disabled\", value: \"none\" },\n            { label: \"Auto\", value: \"auto\" },\n            { label: \"Smart\", value: \"smart\" }\n        ];\n\n        const POSITION_OPTIONS = [\n            { label: \"Popup (Center)\", value: \"fixed\" },\n            { label: \"Above Episode List\", value: \"before-anime-entry-episode-list\" }\n        ];\n\n        const CORNER_OPTIONS = [\n            { label: \"Top Left\", value: \"top-left\" },\n            { label: \"Top Right\", value: \"top-right\" },\n            { label: \"Bottom Left\", value: \"bottom-left\" },\n            { label: \"Bottom Right\", value: \"bottom-right\" }\n        ];\n\n        const FONT_OPTIONS = [\n            { label: \"System Default\", value: \"\" },\n            { label: \"Geist\", value: \"Geist\" },\n            { label: \"Inter\", value: \"Inter, sans-serif\" },\n            { label: \"Roboto\", value: \"Roboto, sans-serif\" },\n            { label: \"Segoe UI\", value: \"'Segoe UI', sans-serif\" },\n            { label: \"SF Pro\", value: \"-apple-system, BlinkMacSystemFont, sans-serif\" },\n            { label: \"JetBrains Mono\", value: \"'JetBrains Mono', monospace\" }\n        ];\n\n        const PROVIDER_LABELS = {\n            \"AnimeTosho Archive\": \"AnimeTosho Archive\",\n            \"AnimeTosho New\": \"AnimeTosho New\",\n            \"Jimaku\": \"Jimaku\",\n            \"TsukiHime\": \"TsukiHime\",\n            \"OpenSubtitles\": \"OpenSubtitles\"\n        };\n\n        function App() {\n            const [subtitles, setSubtitles] = useState([])\n            const [isSearching, setIsSearching] = useState(false)\n            const [searchProviders, setSearchProviders] = useState({})\n            const [selectedUrls, setSelectedUrls] = useState([])\n            const [activeSession, setActiveSession] = useState(false)\n            const [filters, setFilters] = useState({\n                source: \"animetoshoSource\",\n                lang: \"all\",\n                format: \"all\",\n                hi: false,\n                sign: false,\n                honor: false,\n                fansub: \"all\",\n                imdb: \"\",\n                season: \"\",\n                episode: \"\"\n            })\n            const [config, setConfig] = useState({ hasJimakuKey: false, autoSelect: \"none\" })\n            const [showSettings, setShowSettings] = useState(false)\n            // Radix-style floating dropdown: { id, up, top, bottom, left, width, maxHeight }\n            const [dropdown, setDropdown] = useState(null)\n            const [showKey, setShowKey] = useState({ jimaku: false })\n            const [keysExpanded, setKeysExpanded] = useState(null)\n            const [settingsData, setSettingsData] = useState({\n                jimakuKey: \"\",\n                language: \"all\",\n                source: \"animetoshoSource\",\n                format: \"all\",\n                hi: false,\n                signSong: false,\n                honorifics: false,\n                fansub: \"all\",\n                autoSelect: \"none\",\n                webviewPosition: \"${mode}\",\n                fixedCorner: \"top-right\",\n                transparentBg: true,\n                font: \"\"\n            })\n            const [savedSettings, setSavedSettings] = useState(null)\n            const [injecting, setInjecting] = useState({})\n\n            useEffect(() => {\n                if (!window.webview) return\n                const unsubs = [\n                    window.webview.on(\"subtitles\", setSubtitles),\n                    window.webview.on(\"isSearching\", setIsSearching),\n                    window.webview.on(\"searchProviders\", setSearchProviders),\n                    window.webview.on(\"selectedUrls\", setSelectedUrls),\n                    window.webview.on(\"activeSession\", setActiveSession),\n                    window.webview.on(\"filterConfig\", (cfg) => setFilters(prev => ({...prev, ...cfg}))),\n                    window.webview.on(\"pluginConfig\", setConfig),\n                    window.webview.on(\"settings\", (s) => { setSettingsData(s); setSavedSettings(s); })\n                ]\n                return () => unsubs.forEach(u => u())\n            }, [])\n\n            // Clear a row's loading state once the host reports the track as added.\n            useEffect(() => {\n                if (selectedUrls.length === 0) return\n                setInjecting(prev => {\n                    let changed = false\n                    const next = { ...prev }\n                    for (const url of selectedUrls) {\n                        if (next[url]) { delete next[url]; changed = true }\n                    }\n                    return changed ? next : prev\n                })\n            }, [selectedUrls])\n\n            useEffect(() => {\n                const app = savedSettings || settingsData;\n                const fontStack = app.font || \"Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif\";\n                document.body.style.setProperty('--font-family', fontStack)\n            }, [savedSettings, settingsData.font])\n\n            const updateFilter = (key, value) => {\n                const next = { ...filters, [key]: value }\n                setFilters(next)\n                window.webview.send(\"apply-filters\", next)\n            }\n\n            // Maps each dropdown to its options and current value, mirroring the\n            // Radix Select anatomy used across Seanime.\n            const DROPDOWNS = {\n                'f-source': { options: SOURCE_OPTIONS, value: () => filters.source, set: (v) => updateFilter('source', v) },\n                'f-lang': { options: LANG_OPTIONS, value: () => filters.lang, set: (v) => updateFilter('lang', v) },\n                'f-format': { options: FORMAT_OPTIONS, value: () => filters.format, set: (v) => updateFilter('format', v) },\n                'f-fansub': { options: FANSUB_OPTIONS, value: () => filters.fansub, set: (v) => updateFilter('fansub', v) },\n                'source': { options: SOURCE_OPTIONS, value: () => settingsData.source, set: (v) => setSettingsData({ ...settingsData, source: v }) },\n                'lang': { options: LANG_OPTIONS, value: () => settingsData.language, set: (v) => setSettingsData({ ...settingsData, language: v }) },\n                'format': { options: FORMAT_OPTIONS, value: () => settingsData.format, set: (v) => setSettingsData({ ...settingsData, format: v }) },\n                'fansub': { options: FANSUB_OPTIONS, value: () => settingsData.fansub, set: (v) => setSettingsData({ ...settingsData, fansub: v }) },\n                'autoSelect': { options: AUTO_SELECT_OPTIONS, value: () => settingsData.autoSelect, set: (v) => setSettingsData({ ...settingsData, autoSelect: v }) },\n                'position': { options: POSITION_OPTIONS, value: () => settingsData.webviewPosition, set: (v) => setSettingsData({ ...settingsData, webviewPosition: v }) },\n                'corner': { options: CORNER_OPTIONS, value: () => settingsData.fixedCorner, set: (v) => setSettingsData({ ...settingsData, fixedCorner: v }) },\n                'font': { options: FONT_OPTIONS, value: () => settingsData.font, set: (v) => setSettingsData({ ...settingsData, font: v }) },\n            }\n\n            // Anchor the panel to the trigger: below by default, flipped above\n            // when there isn't enough room, height clamped to the available space.\n            const updateDropdownRect = (id, el) => {\n                if (!el) return\n                const rect = el.getBoundingClientRect()\n                const gap = 6, margin = 8, maxH = 300, minH = 160\n                const vh = window.innerHeight || document.documentElement.clientHeight\n                const spaceBelow = vh - rect.bottom - gap - margin\n                const spaceAbove = rect.top - gap - margin\n                const up = spaceBelow < minH && spaceAbove > spaceBelow\n                const avail = Math.max(120, Math.min(maxH, up ? spaceAbove : spaceBelow))\n                const width = Math.min(Math.max(rect.width, 180), window.innerWidth - margin * 2)\n                const left = Math.min(Math.max(rect.left, margin), Math.max(margin, window.innerWidth - width - margin))\n                setDropdown({\n                    id, up, left, width, maxHeight: avail,\n                    top: up ? 0 : rect.bottom + gap,\n                    bottom: up ? (vh - rect.top + gap) : 0\n                })\n            }\n\n            const openDropdown = (id, e) => {\n                e.stopPropagation()\n                if (dropdown && dropdown.id === id) { setDropdown(null); return }\n                updateDropdownRect(id, e.currentTarget)\n            }\n\n            const selectDropdownOption = (id, value, e) => {\n                e.stopPropagation()\n                const conf = DROPDOWNS[id]\n                if (conf) conf.set(value)\n                setDropdown(null)\n            }\n\n            const dropdownStyle = (d) => {\n                const pos = d.up ? ('bottom:' + d.bottom + 'px;') : ('top:' + d.top + 'px;')\n                return 'position:fixed;' + pos + 'left:' + d.left + 'px;width:' + d.width +\n                    'px;min-width:0;max-height:' + d.maxHeight + 'px;z-index:9999;'\n            }\n\n            useEffect(() => {\n                if (!dropdown) return\n                const id = dropdown.id\n                const reposition = () => {\n                    const el = document.querySelector('[data-dropdown-anchor=\"' + id + '\"]')\n                    if (el) updateDropdownRect(id, el)\n                }\n                const onDocClick = (e) => {\n                    const t = e.target\n                    if (t && t.closest && (t.closest('.dd-panel') || t.closest('[data-dropdown-anchor]'))) return\n                    setDropdown(null)\n                }\n                const onKey = (e) => { if (e.key === 'Escape') setDropdown(null) }\n                window.addEventListener('scroll', reposition, true)\n                window.addEventListener('resize', reposition)\n                document.addEventListener('click', onDocClick)\n                document.addEventListener('keydown', onKey)\n                return () => {\n                    window.removeEventListener('scroll', reposition, true)\n                    window.removeEventListener('resize', reposition)\n                    document.removeEventListener('click', onDocClick)\n                    document.removeEventListener('keydown', onKey)\n                }\n            }, [dropdown && dropdown.id])\n\n            // Keep the selected row visible, like Radix's item-aligned content.\n            useEffect(() => {\n                if (!dropdown) return\n                const t = setTimeout(() => {\n                    const panel = document.querySelector('.dd-panel[data-dropdown-panel=\"' + dropdown.id + '\"]')\n                    const sel = panel && panel.querySelector('.dd-option.selected')\n                    if (sel && sel.scrollIntoView) sel.scrollIntoView({ block: 'nearest' })\n                }, 0)\n                return () => clearTimeout(t)\n            }, [dropdown && dropdown.id])\n\n            const inject = (idx, e) => {\n                const sub = subtitles[idx]\n                if (!sub || selectedUrls.includes(sub.url) || injecting[sub.url]) return\n                const btn = e && e.currentTarget\n                if (btn) {\n                    // Add the ripple after Preact re-renders, otherwise the class diff drops it.\n                    requestAnimationFrame(() => {\n                        btn.classList.add(\"rippling\")\n                        setTimeout(() => btn.classList.remove(\"rippling\"), 450)\n                    })\n                }\n                setInjecting(prev => ({ ...prev, [sub.url]: true }))\n                window.webview.send(\"inject-subtitle\", { index: idx })\n                // Fallback: clear the loader if the host never reports success (injection failed).\n                setTimeout(() => setInjecting(prev => {\n                    if (!prev[sub.url]) return prev\n                    const next = { ...prev }\n                    delete next[sub.url]\n                    return next\n                }), 12000)\n            }\n            const manualSearch = () => window.webview.send(\"manual-search\", {\n                imdb: filters.imdb, season: filters.season, episode: filters.episode\n            })\n            const refresh = () => {\n                if (isSearching) return\n                window.webview.send(\"refresh\")\n            }\n            const closeWebview = () => window.webview.send(\"closeWebview\")\n            const resetSettingsData = () => {\n                if (savedSettings) setSettingsData(savedSettings);\n            };\n            const saveSettings = () => {\n                setSavedSettings(settingsData)\n                window.webview.send(\"save-settings\", settingsData)\n                setShowSettings(false)\n                setDropdown(null)\n            }\n            const closeSettings = () => {\n                resetSettingsData();\n                setShowSettings(false)\n                setDropdown(null)\n            }\n\n            const integrated = filters.source.includes(\"Source\")\n            const needsJimakuKey = filters.source === \"jimakuSource\" && !settingsData.jimakuKey\n            const shouldExpandKeys = keysExpanded === null ? needsJimakuKey : keysExpanded\n            const isJimaku = filters.source === \"jimakuSource\"\n            const activeProviders = Object.entries(searchProviders).filter(([k,v]) => v).map(([k]) => k)\n            const appSettings = savedSettings || settingsData\n            const isFixed = appSettings.webviewPosition === \"fixed\"\n            const transparentBg = !isFixed && appSettings.transparentBg\n\n            return html\\`\n                <div class=\"se-root\" data-view=\\${isFixed ? 'modal' : 'inline'} data-transparent=\\${transparentBg ? 'true' : 'false'}>\n                <div class=\"se-overlay\" onClick=\\${(e) => { if (isFixed && e.target === e.currentTarget) closeWebview(); }}>\n                <div class=\"se-card\" onClick=\\${(e) => e.stopPropagation()}>\n                    <div class=\"se-card-header\">\n                        <div>\n                            <div class=\"se-card-title\">\n                                Subtitle Engine\n                                <button class=\"refresh-btn\" onClick=\\${refresh} title=\"Refresh\">\n                                    <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8\"/><path d=\"M3 3v5h5\"/><path d=\"M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16\"/><path d=\"M16 16h5v5\"/></svg>\n                                </button>\n                            </div>\n                            <div class=\"se-card-desc\">\n                                <span class=\"badge-count \\${isSearching ? 'searching' : (subtitles.length > 0 ? 'found' : '')}\">\n                                    \\${isSearching\n                                        ? html\\`<span class=\"badge-dots\"><span></span><span></span><span></span></span> Searching\\`\n                                        : \\`\\${subtitles.length} found\\`}\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"se-actions\">\n                            <button class=\"settings-btn\" onClick=\\${() => { setShowSettings(true); setKeysExpanded(null); }} title=\"Settings\">\n                                <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z\"/></svg>\n                            </button>\n                            <button class=\"close-btn\" onClick=\\${closeWebview} title=\"Close\">\n                                <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 6 6 18\"/><path d=\"m6 6 12 12\"/></svg>\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"se-card-body\">\n                    <div class=\"controls-section\">\n\n                        \\${activeProviders.length > 0 && html\\`\n                            <div class=\"providers\">\n                                \\${activeProviders.map(p => html\\`\n                                    <span class=\"provider-pill active\" key=\\${p}>\\${PROVIDER_LABELS[p] || p}</span>\n                                \\`)}\n                            </div>\n                        \\`}\n\n                        <div class=\"filters\">\n                            <div class=\"dd-group\">\n                                <label class=\"dd-label\">Source</label>\n                                <div class=\"dd-wrap\">\n                                    <button class=\"dd-trigger \\${dropdown?.id === 'f-source' ? 'open' : ''}\" data-dropdown-anchor=\"f-source\" onClick=\\${(e) => openDropdown('f-source', e)}>\n                                        <span class=\"dd-trigger-label\">\\${SOURCE_OPTIONS.find(o => o.value === filters.source)?.label || 'Select'}</span>\n                                        <svg class=\"dd-chevron\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"/></svg>\n                                    </button>\n                                </div>\n                            </div>\n                            <div class=\"dd-group\">\n                                <label class=\"dd-label\">Language</label>\n                                <div class=\"dd-wrap\">\n                                    <button class=\"dd-trigger \\${dropdown?.id === 'f-lang' ? 'open' : ''}\" data-dropdown-anchor=\"f-lang\" onClick=\\${(e) => openDropdown('f-lang', e)}>\n                                        <span class=\"dd-trigger-label\">\\${LANG_OPTIONS.find(o => o.value === filters.lang)?.label || 'Select'}</span>\n                                        <svg class=\"dd-chevron\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"/></svg>\n                                    </button>\n                                </div>\n                            </div>\n                            <div class=\"dd-group\">\n                                <label class=\"dd-label\">Format</label>\n                                <div class=\"dd-wrap\">\n                                    <button class=\"dd-trigger \\${dropdown?.id === 'f-format' ? 'open' : ''}\" data-dropdown-anchor=\"f-format\" onClick=\\${(e) => openDropdown('f-format', e)}>\n                                        <span class=\"dd-trigger-label\">\\${FORMAT_OPTIONS.find(o => o.value === filters.format)?.label || 'Select'}</span>\n                                        <svg class=\"dd-chevron\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"/></svg>\n                                    </button>\n                                </div>\n                            </div>\n                            <div class=\"dd-group\">\n                                <label class=\"dd-label\">Fansub</label>\n                                <div class=\"dd-wrap\">\n                                    <button class=\"dd-trigger \\${dropdown?.id === 'f-fansub' ? 'open' : ''}\" data-dropdown-anchor=\"f-fansub\" onClick=\\${(e) => openDropdown('f-fansub', e)}>\n                                        <span class=\"dd-trigger-label\">\\${FANSUB_OPTIONS.find(o => o.value === filters.fansub)?.label || 'All'}</span>\n                                        <svg class=\"dd-chevron\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"/></svg>\n                                    </button>\n                                </div>\n                            </div>\n                        </div>\n\n                        <div class=\"toggles\">\n                            <div class=\"switch-wrapper\" onClick=\\${() => updateFilter('hi', !filters.hi)}>\n                                <div class=\"switch \\${filters.hi ? 'checked' : ''}\">\n                                    <div class=\"switch-thumb\"></div>\n                                </div>\n                                <span class=\"switch-label\">Closed Captions (CC)</span>\n                            </div>\n                            <div class=\"switch-wrapper\" onClick=\\${() => updateFilter('sign', !filters.sign)}>\n                                <div class=\"switch \\${filters.sign ? 'checked' : ''}\">\n                                    <div class=\"switch-thumb\"></div>\n                                </div>\n                                <span class=\"switch-label\">Forced</span>\n                            </div>\n                            <div class=\"switch-wrapper\" onClick=\\${() => updateFilter('honor', !filters.honor)}>\n                                <div class=\"switch \\${filters.honor ? 'checked' : ''}\">\n                                    <div class=\"switch-thumb\"></div>\n                                </div>\n                                <span class=\"switch-label\">Honorifics</span>\n                            </div>\n                        </div>\n\n                        \\${!integrated && html\\`\n                            <div class=\"manual-search\">\n                                <div class=\"filter-group\">\n                                    <label>IMDB ID</label>\n                                    <input value=\\${filters.imdb} onInput=\\${e => updateFilter('imdb', e.target.value)} placeholder=\"tt0000000\" />\n                                </div>\n                                <div class=\"filter-group small\">\n                                    <label>S</label>\n                                    <input value=\\${filters.season} onInput=\\${e => updateFilter('season', e.target.value)} />\n                                </div>\n                                <div class=\"filter-group small\">\n                                    <label>E</label>\n                                    <input value=\\${filters.episode} onInput=\\${e => updateFilter('episode', e.target.value)} />\n                                </div>\n                                <button class=\"btn btn-primary\" onClick=\\${manualSearch} disabled=\\${isSearching || !filters.imdb}>\n                                    Search\n                                </button>\n                            </div>\n                        \\`}\n\n                        \\${!activeSession && html\\`\n                            <div class=\"alert alert-warning\">\n                                <div class=\"alert-details\">\n                                    <div class=\"alert-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z\"/><line x1=\"12\" x2=\"12\" y1=\"9\" y2=\"13\"/><line x1=\"12\" x2=\"12.01\" y1=\"17\" y2=\"17\"/></svg></div>\n                                    <div class=\"alert-text\">\n                                        <span class=\"alert-title\">No Active Session</span>\n                                        <div class=\"alert-desc\">Subtitle Engine is only compatible with Seanime's built-in player. Please start a video for auto search, or enter an ID manually.</div>\n                                    </div>\n                                </div>\n                            </div>\n                        \\`}\n\n                        \\${activeSession && isJimaku && !config.hasJimakuKey && html\\`\n                            <div class=\"alert alert-error\">\n                                <div class=\"alert-details\">\n                                    <div class=\"alert-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" x2=\"12\" y1=\"8\" y2=\"12\"/><line x1=\"12\" x2=\"12.01\" y1=\"16\" y2=\"16\"/></svg></div>\n                                    <div class=\"alert-text\">\n                                        <span class=\"alert-title\">API Key Required</span>\n                                        <div class=\"alert-desc\">Please set your Jimaku API key in Settings. Register at https://jimaku.cc/login, then get your key at https://jimaku.cc/account.</div>\n                                    </div>\n                                </div>\n                            </div>\n                        \\`}\n\n                        \\${activeSession && subtitles.length === 0 && !isSearching && html\\`\n                            <div class=\"alert alert-warning\">\n                                <div class=\"alert-details\">\n                                    <div class=\"alert-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z\"/><line x1=\"12\" x2=\"12\" y1=\"9\" y2=\"13\"/><line x1=\"12\" x2=\"12.01\" y1=\"17\" y2=\"17\"/></svg></div>\n                                    <div class=\"alert-text\">\n                                        <span class=\"alert-title\">No Results</span>\n                                        <div class=\"alert-desc\">Try changing your search parameters or source.</div>\n                                    </div>\n                                </div>\n                            </div>\n                        \\`}\n\n                        \\${activeSession && subtitles.length === 0 && isSearching && html\\`\n                            <div class=\"empty-state\">\n                                <div class=\"spinner\"></div>\n                                <div>Searching providers...</div>\n                            </div>\n                        \\`}\n                    </div>\n\n                    <div class=\"subtitle-list-wrapper\">\n                        <div class=\"subtitle-list\">\n                            \\${subtitles.map((sub, i) => html\\`\n                                <div class=\"sub-item\" key=\\${i}>\n                                    <div class=\"sub-info\">\n                                        <div class=\"sub-release\" title=\\${sub.release}>\\${sub.release}</div>\n                                        <div class=\"sub-meta\">\n                                            <span class=\"lang-tag\">\n                                                <img class=\"flag\" src=\\${sub.flagUrl} alt=\"\" />\n                                                \\${sub.display.toUpperCase()} (\\${sub.language.toUpperCase()})\n                                            </span>\n                                            \\${sub.isCR && html\\`<span class=\"meta-badge badge-cr\">CR</span>\\`}\n                                            \\${sub.isNF && html\\`<span class=\"meta-badge badge-nf\">NF</span>\\`}\n                                            \\${sub.isAMZN && html\\`<span class=\"meta-badge badge-amzn\">AMZN</span>\\`}\n                                            \\${sub.isATX && html\\`<span class=\"meta-badge badge-atx\">AT-X</span>\\`}\n                                            \\${sub.isBili && html\\`<span class=\"meta-badge badge-bili\">Bili</span>\\`}\n                                            \\${sub.fanSubLevel > 0 && html\\`<span class=\"meta-badge badge-fansub l\\${sub.fanSubLevel}\">L\\${sub.fanSubLevel} Fansub</span>\\`}\n                                            <span class=\"meta-badge badge-format\">\\${sub.format.toUpperCase()}</span>\n                                            \\${sub.isHearingImpaired && html\\`<span class=\"meta-badge badge-cc\">CC</span>\\`}\n                                            \\${sub.isSignSongs && html\\`<span class=\"meta-badge badge-cc\">Forced</span>\\`}\n                                            \\${sub.isHonorifics && html\\`<span class=\"meta-badge badge-cc\">Honorifics</span>\\`}\n                                            <span class=\"source-text\">• \\${sub.source}</span>\n                                        </div>\n                                    </div>\n                                    <button\n                                        class=\"select-btn \\${selectedUrls.includes(sub.url) ? 'added' : (injecting[sub.url] ? 'loading' : 'add')}\"\n                                        disabled=\\${selectedUrls.includes(sub.url) || !!injecting[sub.url]}\n                                        onClick=\\${(e) => inject(i, e)}\n                                    >\n                                        \\${selectedUrls.includes(sub.url)\n                                            ? html\\`<svg class=\"check-pop\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"20 6 9 17 4 12\"/></svg>\\`\n                                            : injecting[sub.url]\n                                                ? html\\`<svg class=\"inject-spinner\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><path d=\"M21 12a9 9 0 1 1-6.22-8.56\"/></svg>\\`\n                                                : html\\`<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><polyline points=\"7 10 12 15 17 10\"/><line x1=\"12\" x2=\"12\" y1=\"15\" y2=\"3\"/></svg>\\`}\n                                    </button>\n                                </div>\n                            \\`)}\n                        </div>\n                    </div>\n                    </div>\n                </div>\n                </div>\n                </div>\n\n                \\${showSettings && html\\`\n                    <div class=\"settings-overlay\" onClick=\\${(e) => { if (e.target === e.currentTarget) closeSettings(); }}>\n                        <div class=\"settings-panel\">\n                            <div class=\"settings-scroll\">\n                                <div class=\"settings-header\">\n                                    <span class=\"settings-title\">Settings</span>\n                                    <button class=\"settings-close\" onClick=\\${closeSettings} title=\"Close\">\n                                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 6 6 18\"/><path d=\"m6 6 12 12\"/></svg>\n                                    </button>\n                                </div>\n\n                                <div class=\"settings-section\">\n                                    <div class=\"settings-section-header\" onClick=\\${() => setKeysExpanded(!shouldExpandKeys)}>\n                                        <div style=\"display: flex; align-items: center;\">\n                                            <span class=\"settings-section-title\">API Keys</span>\n                                            \\${needsJimakuKey && html\\`<span class=\"keys-needed-badge\">Key needed</span>\\`}\n                                        </div>\n                                        <svg class=\"section-chevron \\${shouldExpandKeys ? 'expanded' : ''}\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"/></svg>\n                                    </div>\n                                    \\${shouldExpandKeys && html\\`\n                                        <div class=\"settings-row\">\n                                            <label>Jimaku Key</label>\n                                            <div class=\"key-input-wrap\">\n                                                <input type=\\${showKey.jimaku ? 'text' : 'password'} value=\\${settingsData.jimakuKey} onInput=\\${e => setSettingsData({...settingsData, jimakuKey: e.target.value})} placeholder=\"Enter Jimaku API key\" />\n                                                <button class=\"key-eye-btn\" onClick=\\${() => setShowKey({...showKey, jimaku: !showKey.jimaku})} tabIndex=\"-1\" dangerouslySetInnerHTML=\\${{ __html: showKey.jimaku ? EYE_OPEN_SVG : EYE_CLOSED_SVG }}></button>\n                                            </div>\n                                        </div>\n                                    \\`}\n                                </div>\n\n                                <div class=\"settings-section\">\n                                    <div class=\"settings-section-title\">Default Filters</div>\n                                    <div class=\"settings-row\">\n                                        <label>Source</label>\n                                        <div class=\"dd-wrap\" style=\"flex: 1; max-width: 220px;\">\n                                            <button class=\"dd-trigger \\${dropdown?.id === 'source' ? 'open' : ''}\" data-dropdown-anchor=\"source\" onClick=\\${(e) => openDropdown('source', e)}>\n                                                <span class=\"dd-trigger-label\">\\${SOURCE_OPTIONS.find(o => o.value === settingsData.source)?.label || 'Select'}</span>\n                                                <svg class=\"dd-chevron\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"/></svg>\n                                            </button>\n                                        </div>\n                                    </div>\n                                    <div class=\"settings-row\">\n                                        <label>Language</label>\n                                        <div class=\"dd-wrap\" style=\"flex: 1; max-width: 220px;\">\n                                            <button class=\"dd-trigger \\${dropdown?.id === 'lang' ? 'open' : ''}\" data-dropdown-anchor=\"lang\" onClick=\\${(e) => openDropdown('lang', e)}>\n                                                <span class=\"dd-trigger-label\">\\${LANG_OPTIONS.find(o => o.value === settingsData.language)?.label || 'Select'}</span>\n                                                <svg class=\"dd-chevron\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"/></svg>\n                                            </button>\n                                        </div>\n                                    </div>\n                                    <div class=\"settings-row\">\n                                        <label>Format</label>\n                                        <div class=\"dd-wrap\" style=\"flex: 1; max-width: 220px;\">\n                                            <button class=\"dd-trigger \\${dropdown?.id === 'format' ? 'open' : ''}\" data-dropdown-anchor=\"format\" onClick=\\${(e) => openDropdown('format', e)}>\n                                                <span class=\"dd-trigger-label\">\\${FORMAT_OPTIONS.find(o => o.value === settingsData.format)?.label || 'Select'}</span>\n                                                <svg class=\"dd-chevron\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"/></svg>\n                                            </button>\n                                        </div>\n                                    </div>\n                                    <div class=\"settings-row\">\n                                        <label>Fansub</label>\n                                        <div class=\"dd-wrap\" style=\"flex: 1; max-width: 220px;\">\n                                            <button class=\"dd-trigger \\${dropdown?.id === 'fansub' ? 'open' : ''}\" data-dropdown-anchor=\"fansub\" onClick=\\${(e) => openDropdown('fansub', e)}>\n                                                <span class=\"dd-trigger-label\">\\${FANSUB_OPTIONS.find(o => o.value === settingsData.fansub)?.label || 'All'}</span>\n                                                <svg class=\"dd-chevron\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"/></svg>\n                                            </button>\n                                        </div>\n                                    </div>\n                                    <div class=\"settings-row\">\n                                        <label>Closed Captions</label>\n                                        <div class=\"switch \\${settingsData.hi ? 'checked' : ''}\" onClick=\\${() => setSettingsData({...settingsData, hi: !settingsData.hi})}>\n                                            <div class=\"switch-thumb\"></div>\n                                        </div>\n                                    </div>\n                                    <div class=\"settings-row\">\n                                        <label>Forced</label>\n                                        <div class=\"switch \\${settingsData.signSong ? 'checked' : ''}\" onClick=\\${() => setSettingsData({...settingsData, signSong: !settingsData.signSong})}>\n                                            <div class=\"switch-thumb\"></div>\n                                        </div>\n                                    </div>\n                                    <div class=\"settings-row\">\n                                        <label>Honorifics</label>\n                                        <div class=\"switch \\${settingsData.honorifics ? 'checked' : ''}\" onClick=\\${() => setSettingsData({...settingsData, honorifics: !settingsData.honorifics})}>\n                                            <div class=\"switch-thumb\"></div>\n                                        </div>\n                                    </div>\n                                </div>\n\n                                <div class=\"settings-section\">\n                                    <div class=\"settings-section-title\">Auto Select</div>\n                                    <div class=\"settings-row\">\n                                        <label>Mode</label>\n                                        <div class=\"dd-wrap\" style=\"flex: 1; max-width: 220px;\">\n                                            <button class=\"dd-trigger \\${dropdown?.id === 'autoSelect' ? 'open' : ''}\" data-dropdown-anchor=\"autoSelect\" onClick=\\${(e) => openDropdown('autoSelect', e)}>\n                                                <span class=\"dd-trigger-label\">\\${AUTO_SELECT_OPTIONS.find(o => o.value === settingsData.autoSelect)?.label || 'Select'}</span>\n                                                <svg class=\"dd-chevron\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"/></svg>\n                                            </button>\n                                        </div>\n                                    </div>\n                                </div>\n\n                                <div class=\"settings-section\">\n                                    <div class=\"settings-section-title\">Appearance</div>\n                                    <div class=\"settings-row\">\n                                        <label>Position</label>\n                                        <div class=\"dd-wrap\" style=\"flex: 1; max-width: 220px;\">\n                                            <button class=\"dd-trigger \\${dropdown?.id === 'position' ? 'open' : ''}\" data-dropdown-anchor=\"position\" onClick=\\${(e) => openDropdown('position', e)}>\n                                                <span class=\"dd-trigger-label\">\\${POSITION_OPTIONS.find(o => o.value === settingsData.webviewPosition)?.label || 'Select'}</span>\n                                                <svg class=\"dd-chevron\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"/></svg>\n                                            </button>\n                                        </div>\n                                    </div>\n                                    \\${settingsData.webviewPosition === 'before-anime-entry-episode-list' && html\\`\n                                        <div class=\"settings-row\">\n                                            <label>Transparent BG</label>\n                                            <div class=\"switch \\${settingsData.transparentBg ? 'checked' : ''}\" onClick=\\${() => setSettingsData({...settingsData, transparentBg: !settingsData.transparentBg})}>\n                                                <div class=\"switch-thumb\"></div>\n                                            </div>\n                                        </div>\n                                    \\`}\n                                    <div class=\"settings-row\">\n                                        <label>Font</label>\n                                        <div class=\"dd-wrap\" style=\"flex: 1; max-width: 220px;\">\n                                            <button class=\"dd-trigger \\${dropdown?.id === 'font' ? 'open' : ''}\" data-dropdown-anchor=\"font\" onClick=\\${(e) => openDropdown('font', e)}>\n                                                <span class=\"dd-trigger-label\">\\${FONT_OPTIONS.find(o => o.value === settingsData.font)?.label || 'Select'}</span>\n                                                <svg class=\"dd-chevron\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"/></svg>\n                                            </button>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n\n                            <button class=\"settings-save\" onClick=\\${saveSettings}>Save Settings</button>\n                        </div>\n                    </div>\n                \\`}\n\n                \\${dropdown && html\\`\n                    <div class=\"dd-panel\" data-dropdown-panel=\\${dropdown.id} style=\\${dropdownStyle(dropdown)}>\n                        \\${(DROPDOWNS[dropdown.id] ? DROPDOWNS[dropdown.id].options : []).map(o => {\n                            const selected = DROPDOWNS[dropdown.id].value() === o.value;\n                            return html\\`\n                                <div class=\"dd-option \\${selected ? 'selected' : ''}\" key=\\${o.value} onClick=\\${(e) => selectDropdownOption(dropdown.id, o.value, e)}>\n                                    <div class=\"dd-check\">\n                                        \\${selected && html\\`<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg>\\`}\n                                    </div>\n                                    <span class=\"dd-option-text\">\\${o.label}</span>\n                                </div>\n                            \\`;\n                        })}\n                    </div>\n                \\`}\n            \\`\n        }\n\n        render(html\\`<\\${App} />\\`, document.getElementById(\"app\"))\n    </script>\n</body>\n</html>\n        `;\n        fixedWebview.setContent(() => webViewContent(\"fixed\"));\n        blockWebview.setContent(() => webViewContent(\"before-anime-entry-episode-list\"));\n    });\n}",
