{
  "id": "animesaturn",
  "name": "AnimeSaturn",
  "version": "1.0.3",
  "manifestURI": "https://raw.githubusercontent.com/kRYstall9/Seanime-streaming-providers/refs/heads/main/src/AnimeSaturn/manifest.json",
  "language": "typescript",
  "type": "onlinestream-provider",
