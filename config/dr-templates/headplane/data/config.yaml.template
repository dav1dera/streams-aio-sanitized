{
  "server": {
    "host": "0.0.0.0",
    "port": 3000,
    "base_url": "https://headscale.self-stremiopi.org",
    "cookie_secret": "@@INFISICAL:/headplane/SERVER_COOKIE_SECRET@@",
    "cookie_secure": true,
    "cookie_max_age": 86400,
    "data_path": "/var/lib/headplane",
    "proxy_auth": {
      "enabled": true,
      "user_header": "X-Forwarded-User",
      "email_header": "X-Forwarded-Email",
      "allowed_cidrs": [
        "172.18.0.20/32"
      ]
    }
  },
  "headscale": {
    "url": "https://headscale.self-stremiopi.org",
    "api_key": "@@INFISICAL:/headplane/HEADSCALE_API_KEY@@",
    "config_path": "/etc/headscale/config.yaml",
    "config_strict": true
  },
  "integration": {
    "agent": {
      "enabled": false,
      "host_name": "agent"
    },
    "docker": {
      "enabled": true,
      "container_label": "me.tale.headplane.target=headscale",
      "socket": "unix:///var/run/docker.sock"
    },
    "kubernetes": {
      "enabled": false,
      "validate_manifest": true,
      "pod_name": "headscale"
    },
    "proc": {
      "enabled": false
    }
  },
  "oidc": {
    "enabled": false,
    "default_role": "member",
    "issuer": "https://accounts.google.com",
    "client_id": "739265419098-sn21bi86j92ptav7t6dfne5r0nmoeo9m.apps.googleusercontent.com",
    "client_secret": "@@INFISICAL:/headplane/OIDC_CLIENT_SECRET@@",
    "use_pkce": true,
    "scope": "openid email profile",
    "disable_api_key_login": true,
    "token_endpoint_auth_method": "client_secret_post"
  }
}
