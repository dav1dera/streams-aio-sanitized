*.db-*
*.sqlite*
*.sqlitedb
*.mdb
*.rdb
*.aof
*.dump
*.wal
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.kdb
*.age
*.log
*.bak
*.backup
*.before
*.old
*.zip
*.gz
*.tgz
*.tar
*.7z
*.rar
*.tmp
