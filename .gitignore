# Private inputs and application output, for current AND future services.
.env
.env.*
!.env.example
/.secrets/
/.generated/
/.private-dr/
/.dr-fresh-target.json
**/.ssh/
**/.gnupg/
**/.aws/
**/secrets/
**/private/
**/credentials/
**/backup/
**/backups/
/containers-backup/
/Aiostreams-Stremio-Backups/
**/__pycache__/
**/node_modules/
**/.venv/
**/venv/

# Every new service has public env + an explicit public directory. All other
# content below data/<service> stays private, including DBs without extensions.
/data/*/*
!/data/*/.env
!/data/*/.env.example
!/data/*/public/
!/data/postgres/postgresql.conf

# Known state, credential, archive and temporary formats anywhere.
